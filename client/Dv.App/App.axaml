<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="using:Dv.App.ViewModels"
             xmlns:views="using:Dv.App.Views"
             x:Class="Dv.App.App"
             RequestedThemeVariant="Default">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppBackground"       Color="#f5eeee"/>
                    <SolidColorBrush x:Key="AppSidebar"          Color="#db0b0b"/>
                    <SolidColorBrush x:Key="AppTextPrimary"      Color="#2C3E50"/>
                    <SolidColorBrush x:Key="AppTextMuted"        Color="#718096"/>
                    <SolidColorBrush x:Key="AppCard"             Color="#F0F4F8"/>
                    <SolidColorBrush x:Key="AppCardInner"        Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="AppBorder"           Color="#E2E8F0"/>
                    <SolidColorBrush x:Key="AppInputBackground"  Color="#F9FAFB"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppBackground"       Color="#111827"/>
                    <SolidColorBrush x:Key="AppSidebar"          Color="#7A0808"/>
                    <SolidColorBrush x:Key="AppTextPrimary"      Color="#E2E8F0"/>
                    <SolidColorBrush x:Key="AppTextMuted"        Color="#94A3B8"/>
                    <SolidColorBrush x:Key="AppCard"             Color="#1F2937"/>
                    <SolidColorBrush x:Key="AppCardInner"        Color="#374151"/>
                    <SolidColorBrush x:Key="AppBorder"           Color="#4B5563"/>
                    <SolidColorBrush x:Key="AppInputBackground"  Color="#2D3748"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <Style Selector="ListBox.nav-list > ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="ContainerBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="10"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="ListBox.nav-list > ListBoxItem:pointerover /template/ Border#ContainerBorder">
            <Setter Property="Background" Value="#fe7575" />
        </Style>

        <Style Selector="ListBox.nav-list > ListBoxItem:selected /template/ Border#ContainerBorder">
            <Setter Property="Background" Value="#fe7575" />
        </Style>
    </Application.Styles>

    <Application.DataTemplates>
        <DataTemplate DataType="viewModels:DashboardViewModel">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="viewModels:ProductionUnitsViewModel">
            <views:ProductionUnitsView />
        </DataTemplate>
        <DataTemplate DataType="viewModels:SourceDataViewModel">
            <views:SourceDataView />
        </DataTemplate>
        <DataTemplate DataType="viewModels:OptimizationViewModel">
            <views:OptimizationView />
        </DataTemplate>
        <DataTemplate DataType="viewModels:SettingsViewModel">
            <views:SettingsView />
        </DataTemplate>
    </Application.DataTemplates>
</Application>
