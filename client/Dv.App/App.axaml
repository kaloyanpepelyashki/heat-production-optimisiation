<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="using:Dv.App.ViewModels"
             xmlns:views="using:Dv.App.Views"
             x:Class="Dv.App.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Styles>
        <FluentTheme />

        <Style Selector="ListBox.nav-list > ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="ContainerBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="10"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="ListBox.nav-list > ListBoxItem:pointerover /template/ Border#ContainerBorder">
            <Setter Property="Background" Value="#1E79BE" />
        </Style>

        <Style Selector="ListBox.nav-list > ListBoxItem:selected /template/ Border#ContainerBorder">
            <Setter Property="Background" Value="#1363A4" />
        </Style>
    </Application.Styles>

    <Application.DataTemplates>
        <DataTemplate DataType="viewModels:DashboardViewModel">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="viewModels:ProductionUnitsViewModel">
            <views:ProductionUnitsView />
        </DataTemplate>
        <DataTemplate DataType="viewModels:SourceDataViewModel">
            <views:SourceDataView />
        </DataTemplate>
        <DataTemplate DataType="viewModels:OptimizationViewModel">
            <views:OptimizationView />
        </DataTemplate>
        <DataTemplate DataType="viewModels:SettingsViewModel">
            <views:SettingsView />
        </DataTemplate>
    </Application.DataTemplates>
</Application>