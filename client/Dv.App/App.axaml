<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="using:Dv.App.ViewModels"
             xmlns:views="using:Dv.App.Views"
             x:Class="Dv.App.App"
             RequestedThemeVariant="Default">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppBackground"       Color="#F8FAFC"/>
                    <SolidColorBrush x:Key="AppSidebar"          Color="#DC2626"/>
                    <SolidColorBrush x:Key="AppTextPrimary"      Color="#1E293B"/>
                    <SolidColorBrush x:Key="AppTextMuted"        Color="#64748B"/>
                    <SolidColorBrush x:Key="AppCard"             Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="AppCardInner"        Color="#F1F5F9"/>
                    <SolidColorBrush x:Key="AppBorder"           Color="#E2E8F0"/>
                    <SolidColorBrush x:Key="AppInputBackground"  Color="#F8FAFC"/>
                    <SolidColorBrush x:Key="AppNavHover"         Color="#EF4444"/>
                    <SolidColorBrush x:Key="AppNavSelected"      Color="#B91C1C"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppBackground"       Color="#0F172A"/>
                    <SolidColorBrush x:Key="AppSidebar"          Color="#7F1D1D"/>
                    <SolidColorBrush x:Key="AppTextPrimary"      Color="#F8FAFC"/>
                    <SolidColorBrush x:Key="AppTextMuted"        Color="#94A3B8"/>
                    <SolidColorBrush x:Key="AppCard"             Color="#1E293B"/>
                    <SolidColorBrush x:Key="AppCardInner"        Color="#334155"/>
                    <SolidColorBrush x:Key="AppBorder"           Color="#475569"/>
                    <SolidColorBrush x:Key="AppInputBackground"  Color="#0F172A"/>
                    <SolidColorBrush x:Key="AppNavHover"         Color="#991B1B"/>
                    <SolidColorBrush x:Key="AppNavSelected"      Color="#450A0A"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <Style Selector="ListBox.nav-list > ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="ContainerBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="10"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="ListBox.nav-list > ListBoxItem:pointerover /template/ Border#ContainerBorder">
            <Setter Property="Background" Value="{DynamicResource AppNavHover}" />
        </Style>

        <Style Selector="ListBox.nav-list > ListBoxItem:selected /template/ Border#ContainerBorder">
            <Setter Property="Background" Value="{DynamicResource AppNavSelected}" />
        </Style>
    </Application.Styles>

    <Application.DataTemplates>
        <DataTemplate DataType="viewModels:DashboardViewModel">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="viewModels:ProductionUnitsViewModel">
            <views:ProductionUnitsView />
        </DataTemplate>
        <DataTemplate DataType="viewModels:SourceDataViewModel">
            <views:SourceDataView />
        </DataTemplate>
        <DataTemplate DataType="viewModels:OptimizationViewModel">
            <views:OptimizationView />
        </DataTemplate>
        <DataTemplate DataType="viewModels:SettingsViewModel">
            <views:SettingsView />
        </DataTemplate>
    </Application.DataTemplates>
</Application>
