<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Dv.App.Views"
             xmlns:system="using:System"
             xmlns:viewModels="using:Dv.App.ViewModels"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Avalonia;assembly=LiveChartsCore.SkiaSharpView.Avalonia"
             x:Class="Dv.App.Views.OptimizationView"
             x:CompileBindings="False">


  <ScrollViewer>
    <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto, Auto" Margin="0">


      <!-- Stackpanel for upper rectangle -->
      <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0">
        <Border Background="{DynamicResource AppCard}"
                BoxShadow="0 4 10 0 #33000000"
                CornerRadius="8"
                Margin="10,0,10,10"
                Padding="20">
          <Grid VerticalAlignment="Top" ColumnDefinitions="*, Auto" RowDefinitions="Auto, *">
            <TextBlock Grid.Column="0" Grid.Row="0"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       FontSize="28"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource AppTextPrimary}"
                       Text="Optimization"
                       Margin="10" />


            <WrapPanel Grid.Column="1" Grid.Row="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="10">
              <TextBlock VerticalAlignment="Center"
                         FontSize="14"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource AppTextPrimary}"
                         Text="Choose Scenario: "
                         Margin="0,0,10,0" />
              <!-- Dropdown menu -->
              <ComboBox x:Name="ScenarioComboBox" SelectedIndex="0" MinWidth="120" MaxWidth="200">
                <ComboBoxItem Content="Scenario 1" />
                <ComboBoxItem Content="Scenario 2" />
              </ComboBox>
            </WrapPanel>
          </Grid>
        </Border>
      </StackPanel>

      <!-- The view that changes based on the scenario selection -->
      <Carousel Grid.Row="1" Grid.ColumnSpan="2" SelectedIndex="{Binding #ScenarioComboBox.SelectedIndex}" Margin="10">
        <Carousel.Items>

          <!-- Scenario 1 View -->
          <StackPanel>
            <Border Padding="20">
              <TextBlock Text="Scenario 1" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimary}" HorizontalAlignment="Center" />
            </Border>

            <Border Background="{DynamicResource AppCard}"
                    BoxShadow="0 4 10 0 #33000000"
                    CornerRadius="8"
                    Margin="10,0,10,10"
                    Padding="20">


              <Grid VerticalAlignment="Top" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AppTextPrimary}"
                           Text="Optimization Period"
                           Margin="10" />

                <WrapPanel Grid.Row="0" Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="10">
                  <TextBlock VerticalAlignment="Center"
                             FontSize="14"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource AppTextPrimary}"
                             Text="Choose Period: "
                             Margin="0,0,10,0" />
                  <!-- Dropdown menu periods-->
                  <ComboBox x:Name="PeriodComboBox" SelectedIndex="0" MinWidth="120" MaxWidth="200">
                    <ComboBoxItem Content="Summer" />
                    <ComboBoxItem Content="Winter" />
                  </ComboBox>
                </WrapPanel>


                <!-- Grid for two periods -->
                <Carousel Grid.Row="1" Grid.ColumnSpan="2" SelectedIndex="{Binding #PeriodComboBox.SelectedIndex}" Margin="10,20,10,10">
                  <Carousel.Items>


                    <!-- Stackpanel for Summer view-->
                    <StackPanel Margin="10" DataContext="{Binding SummerScenario1}">
                      <Grid ColumnDefinitions="Auto,Auto,*" Margin="0,0,0,20">

                        <!-- Period Start date -->
                        <StackPanel Grid.Column="0" Spacing="8" Margin="0,0,20,20">
                          <TextBlock Text="Start Date" FontSize="14" Foreground="{DynamicResource AppTextPrimary}" FontWeight="SemiBold"/>
                          <Border Background="{DynamicResource AppInputBackground}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="2" CornerRadius="4" Padding="10,8" MaxWidth="250">
                            <TextBlock Text="08/09/2025 - 00:00" Foreground="{DynamicResource AppTextPrimary}" VerticalAlignment="Center" />
                          </Border>
                        </StackPanel>

                        <!-- Period End Date -->
                        <StackPanel Grid.Column="1" Spacing="8" Margin="0,0,20,20">
                          <TextBlock Text="End Date" FontSize="14" Foreground="{DynamicResource AppTextPrimary}" FontWeight="SemiBold"/>
                          <Border Background="{DynamicResource AppInputBackground}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="2" CornerRadius="4" Padding="10,8" MaxWidth="250">
                            <TextBlock Text="21/09/2025 - 23:59" Foreground="{DynamicResource AppTextPrimary}" VerticalAlignment="Center" />

                          </Border>
                        </StackPanel>

                        <!-- Optimize button to start optimization-->
                        <Button Grid.Column="2"
                                Command="{Binding RunOptimisationCommand}"
                                Content="Optimize"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Margin="0,0,0,20"
                                Padding="18,8"
                                FontWeight="SemiBold"
                                CornerRadius="4">
                          <Button.Styles>
                            <Style Selector="Button">
                              <Setter Property="Background" Value="#16A34A" />
                              <Setter Property="Foreground" Value="White" />
                            </Style>
                            <!-- hover to make it more appealing -->
                            <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                              <Setter Property="Background" Value="#15803D" />
                              <Setter Property="TextBlock.Foreground" Value="White" />
                            </Style>
                          </Button.Styles>
                        </Button>
                      </Grid>

                      <TextBlock VerticalAlignment="Bottom"
                                 FontSize="18"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource AppTextPrimary}"
                                 Text="Schedule Maintenance"
                                 Margin="0,20,10,0"/>
                      <TextBlock VerticalAlignment="Bottom"
                                 FontSize="14"
                                 Foreground="{DynamicResource AppTextPrimary}"
                                 TextWrapping="Wrap"
                                 Text="Click on a unit to mark it for maintenance. Select a time interval lasting 30-60 hours. The interval has to be during the Summer Period."
                                 Margin="0,0,10,10"/>

                      <!-- Selectable Table for Boilers using ListBox -->
                      <Border Background="{DynamicResource AppCardInner}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="8" Padding="10">
                        <StackPanel>
                          <!-- Table names -->
                          <Grid ColumnDefinitions="2*, 1*, 1*" Margin="10,5,10,10">
                            <TextBlock Grid.Column="0" Text="Boiler ID" FontWeight="Bold" Foreground="{DynamicResource AppTextMuted}" />
                            <TextBlock Grid.Column="1" Text="Fuel Type" FontWeight="Bold" Foreground="{DynamicResource AppTextMuted}" />
                            <TextBlock Grid.Column="2" Text="Status" FontWeight="Bold" Foreground="{DynamicResource AppTextMuted}" />
                          </Grid>

                          <Separator Background="{DynamicResource AppBorder}" Height="1" Margin="0,0,0,5" />

                          <!-- Selectable rows for maintenance -->
                          <ListBox ItemsSource="{Binding Boilers}" SelectedItem="{Binding SelectedBoiler, Mode=TwoWay}" Background="Transparent" BorderThickness="0" CornerRadius="4">
                            <ListBox.Styles>
                              <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                              </Style>
                            </ListBox.Styles>
                            <!--Updated listbox to make the status binding-->
                            <ListBox.ItemTemplate>
                              <DataTemplate x:CompileBindings="False">
                                <Grid ColumnDefinitions="2*, 1*, 1*" Margin="10">
                                  <TextBlock Grid.Column="0" Text="{Binding BoilerId}" Foreground="{DynamicResource AppTextPrimary}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                  <TextBlock Grid.Column="1" Text="{Binding FuelType}" Foreground="{DynamicResource AppTextPrimary}" VerticalAlignment="Center"/>
                                  <TextBlock Grid.Column="2" Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" VerticalAlignment="Center"/>
                                </Grid>
                              </DataTemplate>
                            </ListBox.ItemTemplate>
                          </ListBox>
                        </StackPanel>
                      </Border>

                      <!-- Maintenance date choosing -->
                      <Grid ColumnDefinitions="Auto, Auto, *" Margin="0,20,0,0" VerticalAlignment="Top" IsVisible="{Binding SelectedBoiler, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <!-- Maintenance start time -->
                        <StackPanel Grid.Column="0" Spacing="8" Margin="0,0,40,20" VerticalAlignment="Top">
                          <TextBlock Text="Maintenance Start" FontSize="14" Foreground="{DynamicResource AppTextPrimary}" FontWeight="SemiBold"/>
                          <WrapPanel Margin="0">
                            <CalendarDatePicker SelectedDate="{Binding MaintenanceStartDate, Mode=TwoWay}" Width="140" Watermark="Select date" Margin="0,0,10,0"/>
                            <NumericUpDown Minimum="0" Maximum="23" Value="{Binding MaintenanceStartHour, Mode=TwoWay}" FormatString="00" Margin="0" VerticalAlignment="Center" Width="70" ShowButtonSpinner="True"/>
                            <TextBlock Text="{Binding MaintenanceStartHour, StringFormat={}{0:00}}" VerticalAlignment="Center" Margin="8,0,0,0" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimary}"/>
                            <TextBlock Text=": 00" VerticalAlignment="Center" Margin="5,0,0,0" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimary}"/>
                          </WrapPanel>
                        </StackPanel>

                        <!-- Maintenance duration -->
                        <StackPanel Grid.Column="1" Spacing="8" Margin="0,0,20,20" VerticalAlignment="Top">
                          <TextBlock Text="Maintenance Duration" FontSize="14" Foreground="{DynamicResource AppTextPrimary}" FontWeight="SemiBold"/>
                          <Grid Margin="0" ColumnDefinitions="140,Auto,Auto" VerticalAlignment="Center">
                            <Slider Grid.Column="0" Minimum="30" Maximum="60" Value="{Binding MaintenanceDuration, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding MaintenanceDuration}" VerticalAlignment="Center" Margin="10,0,0,0" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimary}"/>
                            <TextBlock Grid.Column="2" Text="hours" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource AppTextMuted}"/>
                          </Grid>
                        </StackPanel>

                        <!-- Confirm Maintenance Button -->
                        <Button Grid.Column="2"
                            HorizontalAlignment="Right"
                          Command="{Binding ScheduleMaintenanceCommand}"
                          Content="Select"
                                FontWeight="SemiBold"
                                CornerRadius="4"
                                Padding="16,8"
                                VerticalAlignment="Bottom"
                                Margin="0,0,0,20">
                            <Button.Styles>
                              <!-- Default state -->
                              <Style Selector="Button">
                                <Setter Property="Background" Value="#3B82F6"/>
                                <Setter Property="Foreground" Value="White"/>
                              </Style>
                              <!-- Hover state, because default made the button not visible -->
                              <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="#2563EB"/>
                                <Setter Property="TextBlock.Foreground" Value="White"/>
                              </Style>
                            </Button.Styles>
                          </Button>
                      </Grid>

                        <TextBlock VerticalAlignment="Bottom"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppTextPrimary}"
                                   Text="Maintenance Schedule"
                                   Margin="0,20,10,0" />

                        <!-- Maintenance Table -->
                        <Border Margin="0,0,0,10" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="4" Padding="10" Background="{DynamicResource AppCard}" BoxShadow="0 4 10 0 #33000000">
                          <!-- Bindings to the OptimizationView -->
                          <Grid Margin="10" RowDefinitions="Auto,Auto,*" ColumnDefinitions="*,*,*,*,*">

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Asset Name" FontWeight="Bold" Margin="10" Foreground="{DynamicResource AppTextPrimary}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="From (Date)" FontWeight="Bold" Margin="10" Foreground="{DynamicResource AppTextPrimary}"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="To (Date)" FontWeight="Bold" Margin="10" Foreground="{DynamicResource AppTextPrimary}"/>
                            <TextBlock Grid.Row="0" Grid.Column="3" Text="Period" FontWeight="Bold" Margin="10" Foreground="{DynamicResource AppTextPrimary}"/>
                            <TextBlock Grid.Row="0" Grid.Column="4" Text="Scenario" FontWeight="Bold" Margin="10" Foreground="{DynamicResource AppTextPrimary}"/>

                            <!-- Line separating rows -->
                            <Rectangle Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5" Height="1" Fill="{DynamicResource AppBorder}" VerticalAlignment="Bottom"/>

                            <ItemsControl ItemsSource="{Binding Schedules}" Grid.Row="2" Grid.ColumnSpan="5">
                              <ItemsControl.ItemTemplate>
                              <DataTemplate x:CompileBindings="False">
                                  <Grid ColumnDefinitions="*,*,*,*,*">
                                    <TextBlock Grid.Column="0" Text="{Binding AssetName}" Margin="10" Foreground="{DynamicResource AppTextPrimary}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding StartDate, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Margin="10" Foreground="{DynamicResource AppTextPrimary}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding EndDate, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Margin="10" Foreground="{DynamicResource AppTextPrimary}"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Period}" Margin="10" Foreground="{DynamicResource AppTextPrimary}"/>
                                    <TextBlock Grid.Column="4" Text="{Binding Scenario}" Margin="10" Foreground="{DynamicResource AppTextPrimary}"/>
                                  </Grid>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </Grid>
                        </Border>

                        <!-- Heat demand graph SUMMER -->
                        <Border Margin="0,20,0,0"
                                Background="{DynamicResource AppCardInner}"
                                BorderBrush="{DynamicResource AppBorder}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                          <StackPanel Spacing="12">
                            <TextBlock Text="Heat Demand"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AppTextPrimary}" />

                            <Grid Height="260">
                              <lvc:CartesianChart
                                                  x:Name="SummerHeatDemandChartScenario1"
                                                  Background="{DynamicResource AppBackground}"
                                                  ZoomMode="None"
                                                  Margin="0">
                              </lvc:CartesianChart>
                            </Grid>
                          </StackPanel>
                        </Border>

                        <!-- Electricity price graph SUMMER -->
                        <Border Margin="0,16,0,0"
                                Background="{DynamicResource AppCardInner}"
                                BorderBrush="{DynamicResource AppBorder}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                          <StackPanel Spacing="12">
                            <TextBlock Text="Electricity Price"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AppTextPrimary}" />

                            <Grid Height="260">
                              <lvc:CartesianChart
                                                  x:Name="SummerElectricityPriceChartScenario1"
                                                  Background="{DynamicResource AppBackground}"
                                                  ZoomMode="None"
                                                  Margin="0">
                              </lvc:CartesianChart>
                            </Grid>

                            <TextBlock Text="The Price is set in DKK per MWh(el)."
                                       FontSize="14"
                                       Foreground="{DynamicResource AppTextMuted}"
                                       TextWrapping="Wrap" />
                          </StackPanel>
                        </Border>

                        <!-- Optimisation Status -->
                        <StackPanel IsVisible="{Binding IsOptimising}" Margin="0,20,0,0" HorizontalAlignment="Center">
                          <TextBlock Text="Running optimisation, this may take a moment..." FontSize="14" Foreground="{DynamicResource AppTextMuted}" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock IsVisible="{Binding OptimisationStatusMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
                                   Text="{Binding OptimisationStatusMessage}"
                                   FontSize="14"
                                   Foreground="#EF4444"
                                   Margin="0,10,0,0"
                                   TextWrapping="Wrap"/>

                        <!-- Optimisation Results -->
                        <Border IsVisible="{Binding HasOptimisationResults}"
                                Margin="0,20,0,0"
                                Background="{DynamicResource AppCard}"
                                BoxShadow="0 4 10 0 #33000000"
                                CornerRadius="8"
                                Padding="20">
                          <StackPanel>
                            <TextBlock Text="Optimisation Results"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AppTextPrimary}"
                                       Margin="0,0,0,16"/>

                            <!-- Summary cards -->
                            <Grid ColumnDefinitions="*,*,*" Margin="0,0,0,20">
                              <Border Grid.Column="0" Background="{DynamicResource AppCardInner}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,8,0">
                                <StackPanel>
                                  <TextBlock Text="Total Heat Production" FontSize="12" Foreground="{DynamicResource AppTextMuted}" Margin="0,0,0,4"/>
                                  <TextBlock Text="{Binding TotalHeatProduction, StringFormat='{}{0:F2} MWh'}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}"/>
                                </StackPanel>
                              </Border>
                              <Border Grid.Column="1" Background="{DynamicResource AppCardInner}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="4,0,4,0">
                                <StackPanel>
                                  <TextBlock Text="Total Expenses" FontSize="12" Foreground="{DynamicResource AppTextMuted}" Margin="0,0,0,4"/>
                                  <TextBlock Text="{Binding TotalExpenses, StringFormat='{}{0:F2} DKK'}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}"/>
                                </StackPanel>
                              </Border>
                              <Border Grid.Column="2" Background="{DynamicResource AppCardInner}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="8,0,0,0">
                                <StackPanel>
                                  <TextBlock Text="Total CO2 Emissions" FontSize="12" Foreground="{DynamicResource AppTextMuted}" Margin="0,0,0,4"/>
                                  <TextBlock Text="{Binding TotalCo2Emissions, StringFormat='{}{0:F2} kg'}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}"/>
                                </StackPanel>
                              </Border>
                            </Grid>

                            <!-- Hourly results table -->
                            <Border Background="{DynamicResource AppCardInner}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="8" Padding="10">
                              <StackPanel>
                                <Grid ColumnDefinitions="2*,1*,1*,1*,1*" Margin="10,5,10,10">
                                  <TextBlock Grid.Column="0" Text="Time" FontWeight="Bold" Foreground="{DynamicResource AppTextMuted}"/>
                                  <TextBlock Grid.Column="1" Text="Heat (MWh)" FontWeight="Bold" Foreground="{DynamicResource AppTextMuted}"/>
                                  <TextBlock Grid.Column="2" Text="Electricity (MWh)" FontWeight="Bold" Foreground="{DynamicResource AppTextMuted}"/>
                                  <TextBlock Grid.Column="3" Text="Expenses (DKK)" FontWeight="Bold" Foreground="{DynamicResource AppTextMuted}"/>
                                  <TextBlock Grid.Column="4" Text="CO2 (kg)" FontWeight="Bold" Foreground="{DynamicResource AppTextMuted}"/>
                                </Grid>
                                <Separator Background="{DynamicResource AppBorder}" Height="1" Margin="0,0,0,5"/>
                                <ItemsControl ItemsSource="{Binding OptimisationResults}">
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate x:CompileBindings="False">
                                      <Grid ColumnDefinitions="2*,1*,1*,1*,1*" Margin="10,6">
                                        <TextBlock Grid.Column="0" Text="{Binding TimeFrom, StringFormat='{}{0:dd MMM HH:mm}'}" Foreground="{DynamicResource AppTextPrimary}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding HeatProduction, StringFormat='{}{0:F2}'}" Foreground="{DynamicResource AppTextPrimary}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding ElectricityConsumption, StringFormat='{}{0:F2}'}" Foreground="{DynamicResource AppTextPrimary}"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Expenses, StringFormat='{}{0:F2}'}" Foreground="{DynamicResource AppTextPrimary}"/>
                                        <TextBlock Grid.Column="4" Text="{Binding Co2Emissions, StringFormat='{}{0:F2}'}" Foreground="{DynamicResource AppTextPrimary}"/>
                                      </Grid>
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>
                              </StackPanel>
                            </Border>
                          </StackPanel>
                        </Border>

                    </StackPanel>

                    <!-- Stackpanel for Winter view-->
                    <StackPanel Margin="10" DataContext="{Binding WinterScenario1}">
                      <Grid ColumnDefinitions="Auto,Auto,*" Margin="0,0,0,20">

                        <!-- Period Start Date -->
                        <StackPanel Grid.Column="0" Spacing="8" Margin="0,0,20,20">
                          <TextBlock Text="Start Date" FontSize="14" Foreground="{DynamicResource AppTextPrimary}" FontWeight="SemiBold"/>
                          <Border Background="{DynamicResource AppInputBackground}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="2" CornerRadius="4" Padding="10,8" MaxWidth="250">
                            <TextBlock Text="05/01/2026 - 00:00" Foreground="{DynamicResource AppTextPrimary}" VerticalAlignment="Center" />
                          </Border>
                        </StackPanel>

                        <!-- Period End Date -->
                        <StackPanel Grid.Column="1" Spacing="8" Margin="0,0,20,20">
                          <TextBlock Text="End Date" FontSize="14" Foreground="{DynamicResource AppTextPrimary}" FontWeight="SemiBold"/>
                          <Border Background="{DynamicResource AppInputBackground}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="2" CornerRadius="4" Padding="10,8" MaxWidth="250">
                            <TextBlock Text="18/01/2026 - 23:59" Foreground="{DynamicResource AppTextPrimary}" VerticalAlignment="Center" />

                          </Border>
                        </StackPanel>

                        <!-- Optimize button to start optimization -->
                        <Button Grid.Column="2"
                                Command="{Binding RunOptimisationCommand}"
                                Content="Optimize"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Margin="0,0,0,20"
                                Padding="18,8"
                                FontWeight="SemiBold"
                                CornerRadius="4">
                          <Button.Styles>
                            <Style Selector="Button">
                              <Setter Property="Background" Value="#16A34A" />
                              <Setter Property="Foreground" Value="White" />
                            </Style>

                            <!-- hover to make it more appealing -->
                            <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                              <Setter Property="Background" Value="#15803D" />
                              <Setter Property="TextBlock.Foreground" Value="White" />
                            </Style>
                          </Button.Styles>
                        </Button>
                      </Grid>

                      <TextBlock VerticalAlignment="Bottom"
                                 FontSize="18"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource AppTextPrimary}"
                                 Text="Schedule Maintenance"
                                 Margin="0,20,10,0"/>
                      <TextBlock VerticalAlignment="Bottom"
                                 FontSize="14"
                                 Foreground="{DynamicResource AppTextPrimary}"
                                 TextWrapping="Wrap"
                                 Text="Click on a unit to mark it for maintenance. Select a time interval lasting 30-60 hours. The interval has to be during the Winter Period."
                                 Margin="0,0,10,10"/>

                      <!-- Selectable Table for Boilers using ListBox -->
                      <Border Background="{DynamicResource AppCardInner}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="8" Padding="10">
                        <StackPanel>
                          <!-- Table names -->
                          <Grid ColumnDefinitions="2*, 1*, 1*" Margin="10,5,10,10">
                            <TextBlock Grid.Column="0" Text="Boiler ID" FontWeight="Bold" Foreground="{DynamicResource AppTextMuted}" />
                            <TextBlock Grid.Column="1" Text="Fuel Type" FontWeight="Bold" Foreground="{DynamicResource AppTextMuted}" />
                            <TextBlock Grid.Column="2" Text="Status" FontWeight="Bold" Foreground="{DynamicResource AppTextMuted}" />
                          </Grid>

                          <Separator Background="{DynamicResource AppBorder}" Height="1" Margin="0,0,0,5" />

                          <!-- Selectable rows for maintenance -->
                          <ListBox ItemsSource="{Binding Boilers}" SelectedItem="{Binding SelectedBoiler, Mode=TwoWay}" Background="Transparent" BorderThickness="0" CornerRadius="4">
                            <ListBox.Styles>
                              <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                              </Style>
                            </ListBox.Styles>
                            <ListBox.ItemTemplate>
                              <DataTemplate x:CompileBindings="False">
                                <Grid ColumnDefinitions="2*, 1*, 1*" Margin="10">
                                  <TextBlock Grid.Column="0" Text="{Binding BoilerId}" Foreground="{DynamicResource AppTextPrimary}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                  <TextBlock Grid.Column="1" Text="{Binding FuelType}" Foreground="{DynamicResource AppTextPrimary}" VerticalAlignment="Center"/>
                                  <TextBlock Grid.Column="2" Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" VerticalAlignment="Center"/>
                                </Grid>
                              </DataTemplate>
                            </ListBox.ItemTemplate>
                          </ListBox>
                        </StackPanel>
                      </Border>

                      <!-- Maintenance Date choosing -->
                      <Grid ColumnDefinitions="Auto, Auto, *" Margin="0,20,0,0" VerticalAlignment="Top" IsVisible="{Binding SelectedBoiler, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <!-- Maintenance start time -->
                        <StackPanel Grid.Column="0" Spacing="8" Margin="0,0,40,20" VerticalAlignment="Top">
                          <TextBlock Text="Maintenance Start" FontSize="14" Foreground="{DynamicResource AppTextPrimary}" FontWeight="SemiBold"/>
                          <WrapPanel Margin="0">
                            <CalendarDatePicker SelectedDate="{Binding MaintenanceStartDate, Mode=TwoWay}" Width="140" Watermark="Select date" Margin="0,0,10,0" />
                            <NumericUpDown Minimum="0" Maximum="23" Value="{Binding MaintenanceStartHour, Mode=TwoWay}" FormatString="00" Margin="0" VerticalAlignment="Center" Width="70" ShowButtonSpinner="True"/>
                            <TextBlock Text="{Binding MaintenanceStartHour, StringFormat={}{0:00}}" VerticalAlignment="Center" Margin="8,0,0,0" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimary}"/>
                            <TextBlock Text=": 00" VerticalAlignment="Center" Margin="5,0,0,0" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimary}"/>
                          </WrapPanel>
                        </StackPanel>

                        <!-- Maintenance duration -->
                        <StackPanel Grid.Column="1" Spacing="8" Margin="0,0,20,20" VerticalAlignment="Top">
                          <TextBlock Text="Maintenance Duration" FontSize="14" Foreground="{DynamicResource AppTextPrimary}" FontWeight="SemiBold"/>
                          <Grid Margin="0" ColumnDefinitions="140,Auto,Auto" VerticalAlignment="Center">
                            <Slider Grid.Column="0" Minimum="30" Maximum="60" Value="{Binding MaintenanceDuration, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding MaintenanceDuration}" VerticalAlignment="Center" Margin="10,0,0,0" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimary}"/>
                            <TextBlock Grid.Column="2" Text="hours" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource AppTextMuted}"/>
                          </Grid>
                        </StackPanel>

                        <!-- Confirm Maintenance Button -->
                        <Button Grid.Column="2"
                            HorizontalAlignment="Right"
                          Command="{Binding ScheduleMaintenanceCommand}"
                          Content="Select"
                                FontWeight="SemiBold"
                                CornerRadius="4"
                                Padding="16,8"
                                VerticalAlignment="Bottom"
                                Margin="0,0,0,20">
                          <Button.Styles>
                            <!-- Default state -->
                            <Style Selector="Button">
                              <Setter Property="Background" Value="#3B82F6"/>
                              <Setter Property="Foreground" Value="White"/>
                            </Style>
                            <!-- Hover state, because default made the button not visible -->
                            <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                              <Setter Property="Background" Value="#2563EB"/>
                              <Setter Property="TextBlock.Foreground" Value="White"/>
                            </Style>
                          </Button.Styles>
                        </Button>
                      </Grid>

                      <TextBlock VerticalAlignment="Bottom"
                                 FontSize="18"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource AppTextPrimary}"
                                 Text="Maintenance Schedule"
                                 Margin="0,20,10,0" />

                      <!-- Maintenance Table -->
                      <Border Margin="0,0,0,10" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="4" Padding="10" Background="{DynamicResource AppCard}" BoxShadow="0 4 10 0 #33000000">
                        <!-- Bindings to the OptimizationView -->
                        <Grid Margin="10" RowDefinitions="Auto,Auto,*" ColumnDefinitions="*,*,*,*,*">

                          <TextBlock Grid.Row="0" Grid.Column="0" Text="Asset Name" FontWeight="Bold" Margin="10" Foreground="{DynamicResource AppTextPrimary}"/>
                          <TextBlock Grid.Row="0" Grid.Column="1" Text="From (Date)" FontWeight="Bold" Margin="10" Foreground="{DynamicResource AppTextPrimary}"/>
                          <TextBlock Grid.Row="0" Grid.Column="2" Text="To (Date)" FontWeight="Bold" Margin="10" Foreground="{DynamicResource AppTextPrimary}"/>
                          <TextBlock Grid.Row="0" Grid.Column="3" Text="Period" FontWeight="Bold" Margin="10" Foreground="{DynamicResource AppTextPrimary}"/>
                          <TextBlock Grid.Row="0" Grid.Column="4" Text="Scenario" FontWeight="Bold" Margin="10" Foreground="{DynamicResource AppTextPrimary}"/>

                          <!-- Line separating rows -->
                          <Rectangle Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5" Height="1" Fill="{DynamicResource AppBorder}" VerticalAlignment="Bottom"/>

                            <ItemsControl ItemsSource="{Binding Schedules}" Grid.Row="2" Grid.ColumnSpan="5">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:CompileBindings="False">
                                <Grid ColumnDefinitions="*,*,*,*,*">
                                  <TextBlock Grid.Column="0" Text="{Binding AssetName}" Margin="10" Foreground="{DynamicResource AppTextPrimary}"/>
                                  <TextBlock Grid.Column="1" Text="{Binding StartDate, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Margin="10" Foreground="{DynamicResource AppTextPrimary}"/>
                                  <TextBlock Grid.Column="2" Text="{Binding EndDate, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Margin="10" Foreground="{DynamicResource AppTextPrimary}"/>
                                  <TextBlock Grid.Column="3" Text="{Binding Period}" Margin="10" Foreground="{DynamicResource AppTextPrimary}"/>
                                  <TextBlock Grid.Column="4" Text="{Binding Scenario}" Margin="10" Foreground="{DynamicResource AppTextPrimary}"/>
                                </Grid>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </Grid>
                      </Border>

                      <!-- Heat demand graph for the winter maintenance process -->
                      <Border Margin="0,20,0,0"
                              Background="{DynamicResource AppCardInner}"
                              BorderBrush="{DynamicResource AppBorder}"
                              BorderThickness="1"
                              CornerRadius="8"
                              Padding="16">
                        <StackPanel Spacing="12">
                          <TextBlock Text="Heat Demand"
                                     FontSize="18"
                                     FontWeight="SemiBold"
                                     Foreground="{DynamicResource AppTextPrimary}" />

                          <Grid Height="260">
                            <lvc:CartesianChart
                                                x:Name="WinterHeatDemandChartScenario1"
                                                Background="{DynamicResource AppBackground}"
                                                ZoomMode="None"
                                                Margin="0">
                            </lvc:CartesianChart>
                          </Grid>
                        </StackPanel>
                      </Border>

                      <Border Margin="0,16,0,0"
                              Background="{DynamicResource AppCardInner}"
                              BorderBrush="{DynamicResource AppBorder}"
                              BorderThickness="1"
                              CornerRadius="8"
                              Padding="16">
                        <StackPanel Spacing="12">
                          <TextBlock Text="Electricity Price"
                                     FontSize="18"
                                     FontWeight="SemiBold"
                                     Foreground="{DynamicResource AppTextPrimary}" />

                          <Grid Height="260">
                            <lvc:CartesianChart
                                                x:Name="WinterElectricityPriceChartScenario1"
                                                Background="{DynamicResource AppBackground}"
                                                ZoomMode="None"
                                                Margin="0">
                            </lvc:CartesianChart>
                          </Grid>

                          <TextBlock Text="The Price is set in DKK per MWh(el)."
                                     FontSize="14"
                                     Foreground="{DynamicResource AppTextMuted}"
                                     TextWrapping="Wrap" />
                        </StackPanel>
                      </Border>

                      <!-- Optimisation Status -->
                      <StackPanel IsVisible="{Binding IsOptimising}" Margin="0,20,0,0" HorizontalAlignment="Center">
                        <TextBlock Text="Running optimisation, this may take a moment..." FontSize="14" Foreground="{DynamicResource AppTextMuted}" HorizontalAlignment="Center"/>
                      </StackPanel>

                      <TextBlock IsVisible="{Binding OptimisationStatusMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
                                 Text="{Binding OptimisationStatusMessage}"
                                 FontSize="14"
                                 Foreground="#EF4444"
                                 Margin="0,10,0,0"
                                 TextWrapping="Wrap"/>

                      <!-- Optimisation Results -->
                      <Border IsVisible="{Binding HasOptimisationResults}"
                              Margin="0,20,0,0"
                              Background="{DynamicResource AppCard}"
                              BoxShadow="0 4 10 0 #33000000"
                              CornerRadius="8"
                              Padding="20">
                        <StackPanel>
                          <TextBlock Text="Optimisation Results"
                                     FontSize="18"
                                     FontWeight="SemiBold"
                                     Foreground="{DynamicResource AppTextPrimary}"
                                     Margin="0,0,0,16"/>

                          <!-- Summary cards -->
                          <Grid ColumnDefinitions="*,*,*" Margin="0,0,0,20">
                            <Border Grid.Column="0" Background="{DynamicResource AppCardInner}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,8,0">
                              <StackPanel>
                                <TextBlock Text="Total Heat Production" FontSize="12" Foreground="{DynamicResource AppTextMuted}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding TotalHeatProduction, StringFormat='{}{0:F2} MWh'}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}"/>
                              </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="{DynamicResource AppCardInner}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="4,0,4,0">
                              <StackPanel>
                                <TextBlock Text="Total Expenses" FontSize="12" Foreground="{DynamicResource AppTextMuted}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding TotalExpenses, StringFormat='{}{0:F2} DKK'}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}"/>
                              </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="{DynamicResource AppCardInner}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="8,0,0,0">
                              <StackPanel>
                                <TextBlock Text="Total CO2 Emissions" FontSize="12" Foreground="{DynamicResource AppTextMuted}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding TotalCo2Emissions, StringFormat='{}{0:F2} kg'}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}"/>
                              </StackPanel>
                            </Border>
                          </Grid>

                          <!-- Hourly results table -->
                          <Border Background="{DynamicResource AppCardInner}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="8" Padding="10">
                            <StackPanel>
                              <Grid ColumnDefinitions="2*,1*,1*,1*,1*" Margin="10,5,10,10">
                                <TextBlock Grid.Column="0" Text="Time" FontWeight="Bold" Foreground="{DynamicResource AppTextMuted}"/>
                                <TextBlock Grid.Column="1" Text="Heat (MWh)" FontWeight="Bold" Foreground="{DynamicResource AppTextMuted}"/>
                                <TextBlock Grid.Column="2" Text="Electricity (MWh)" FontWeight="Bold" Foreground="{DynamicResource AppTextMuted}"/>
                                <TextBlock Grid.Column="3" Text="Expenses (DKK)" FontWeight="Bold" Foreground="{DynamicResource AppTextMuted}"/>
                                <TextBlock Grid.Column="4" Text="CO2 (kg)" FontWeight="Bold" Foreground="{DynamicResource AppTextMuted}"/>
                              </Grid>
                              <Separator Background="{DynamicResource AppBorder}" Height="1" Margin="0,0,0,5"/>
                              <ItemsControl ItemsSource="{Binding OptimisationResults}">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate x:CompileBindings="False">
                                    <Grid ColumnDefinitions="2*,1*,1*,1*,1*" Margin="10,6">
                                      <TextBlock Grid.Column="0" Text="{Binding TimeFrom, StringFormat='{}{0:dd MMM HH:mm}'}" Foreground="{DynamicResource AppTextPrimary}"/>
                                      <TextBlock Grid.Column="1" Text="{Binding HeatProduction, StringFormat='{}{0:F2}'}" Foreground="{DynamicResource AppTextPrimary}"/>
                                      <TextBlock Grid.Column="2" Text="{Binding ElectricityConsumption, StringFormat='{}{0:F2}'}" Foreground="{DynamicResource AppTextPrimary}"/>
                                      <TextBlock Grid.Column="3" Text="{Binding Expenses, StringFormat='{}{0:F2}'}" Foreground="{DynamicResource AppTextPrimary}"/>
                                      <TextBlock Grid.Column="4" Text="{Binding Co2Emissions, StringFormat='{}{0:F2}'}" Foreground="{DynamicResource AppTextPrimary}"/>
                                    </Grid>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </StackPanel>
                          </Border>
                        </StackPanel>
                      </Border>

                    </StackPanel>

                  </Carousel.Items>
                </Carousel>
              </Grid>
            </Border>
          </StackPanel>




          <!-- Scenario 2 View -->
          <StackPanel>
            <Border Padding="20">
              <TextBlock Text="Scenario 2" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimary}" HorizontalAlignment="Center" />
            </Border>

            <Border Background="{DynamicResource AppCard}"
                    BoxShadow="0 4 10 0 #33000000"
                    CornerRadius="8"
                    Margin="10,0,10,10"
                    Padding="20">


              <Grid VerticalAlignment="Top" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AppTextPrimary}"
                           Text="Optimization Period"
                           Margin="10" />

                <WrapPanel Grid.Row="0" Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="10">
                  <TextBlock VerticalAlignment="Center"
                             FontSize="14"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource AppTextPrimary}"
                             Text="Choose Period: "
                             Margin="0,0,10,0" />
                  <!-- Dropdown menu periods-->
                  <ComboBox x:Name="PeriodComboBoxScenario2" SelectedIndex="0" MinWidth="120" MaxWidth="200">
                    <ComboBoxItem Content="Summer" />
                    <ComboBoxItem Content="Winter" />
                  </ComboBox>
                </WrapPanel>


                <!-- Grid for two periods -->
                <Carousel Grid.Row="1" Grid.ColumnSpan="2" SelectedIndex="{Binding #PeriodComboBoxScenario2.SelectedIndex}" Margin="10,20,10,10">
                  <Carousel.Items>


                    <!-- Stackpanel for Summer view-->
                    <StackPanel Margin="10" DataContext="{Binding SummerScenario2}">
                      <Grid ColumnDefinitions="Auto,Auto,*" Margin="0,0,0,20">

                        <!-- Period Start date -->
                        <StackPanel Grid.Column="0" Spacing="8" Margin="0,0,20,20">
                          <TextBlock Text="Start Date" FontSize="14" Foreground="{DynamicResource AppTextPrimary}" FontWeight="SemiBold"/>
                          <Border Background="{DynamicResource AppInputBackground}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="2" CornerRadius="4" Padding="10,8" MaxWidth="250">
                            <TextBlock Text="08/09/2025 - 00:00" Foreground="{DynamicResource AppTextPrimary}" VerticalAlignment="Center" />
                          </Border>
                        </StackPanel>

                        <!-- Period End Date -->
                        <StackPanel Grid.Column="1" Spacing="8" Margin="0,0,20,20">
                          <TextBlock Text="End Date" FontSize="14" Foreground="{DynamicResource AppTextPrimary}" FontWeight="SemiBold"/>
                          <Border Background="{DynamicResource AppInputBackground}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="2" CornerRadius="4" Padding="10,8" MaxWidth="250">
                            <TextBlock Text="21/09/2025 - 23:59" Foreground="{DynamicResource AppTextPrimary}" VerticalAlignment="Center" />

                          </Border>
                        </StackPanel>

                        <!-- Optimize button to start optimization-->
                        <Button Grid.Column="2"
                                Command="{Binding RunOptimisationCommand}"
                                Content="Optimize"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Margin="0,0,0,20"
                                Padding="18,8"
                                FontWeight="SemiBold"
                                CornerRadius="4">
                          <Button.Styles>
                            <Style Selector="Button">
                              <Setter Property="Background" Value="#16A34A" />
                              <Setter Property="Foreground" Value="White" />
                            </Style>
                            <!-- hover to make it more appealing -->
                            <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                              <Setter Property="Background" Value="#15803D" />
                              <Setter Property="TextBlock.Foreground" Value="White" />
                            </Style>
                          </Button.Styles>
                        </Button>
                      </Grid>

                      <TextBlock VerticalAlignment="Bottom"
                                 FontSize="18"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource AppTextPrimary}"
                                 Text="Schedule Maintenance"
                                 Margin="0,20,10,0"/>
                      <TextBlock VerticalAlignment="Bottom"
                                 FontSize="14"
                                 Foreground="{DynamicResource AppTextPrimary}"
                                 TextWrapping="Wrap"
                                 Text="Click on a unit to mark it for maintenance. Select a time interval lasting 30-60 hours. The interval has to be during the Summer Period."
                                 Margin="0,0,10,10"/>

                      <!-- Selectable Table for Boilers using ListBox -->
                      <Border Background="{DynamicResource AppCardInner}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="8" Padding="10">
                        <StackPanel>
                          <!-- Table names -->
                          <Grid ColumnDefinitions="2*, 1*, 1*" Margin="10,5,10,10">
                            <TextBlock Grid.Column="0" Text="Boiler ID" FontWeight="Bold" Foreground="{DynamicResource AppTextMuted}" />
                            <TextBlock Grid.Column="1" Text="Fuel Type" FontWeight="Bold" Foreground="{DynamicResource AppTextMuted}" />
                            <TextBlock Grid.Column="2" Text="Status" FontWeight="Bold" Foreground="{DynamicResource AppTextMuted}" />
                          </Grid>

                          <Separator Background="{DynamicResource AppBorder}" Height="1" Margin="0,0,0,5" />

                          <!-- Selectable rows for maintenance -->
                          <ListBox ItemsSource="{Binding Boilers}" SelectedItem="{Binding SelectedBoiler, Mode=TwoWay}" Background="Transparent" BorderThickness="0" CornerRadius="4">
                            <ListBox.Styles>
                              <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                              </Style>
                            </ListBox.Styles>
                            <!--Updated listbox to make the status binding-->
                            <ListBox.ItemTemplate>
                              <DataTemplate x:CompileBindings="False">
                                <Grid ColumnDefinitions="2*, 1*, 1*" Margin="10">
                                  <TextBlock Grid.Column="0" Text="{Binding BoilerId}" Foreground="{DynamicResource AppTextPrimary}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                  <TextBlock Grid.Column="1" Text="{Binding FuelType}" Foreground="{DynamicResource AppTextPrimary}" VerticalAlignment="Center"/>
                                  <TextBlock Grid.Column="2" Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" VerticalAlignment="Center"/>
                                </Grid>
                              </DataTemplate>
                            </ListBox.ItemTemplate>
                          </ListBox>
                        </StackPanel>
                      </Border>

                      <!-- Maintenance date choosing -->
                      <Grid ColumnDefinitions="Auto, Auto, *" Margin="0,20,0,0" VerticalAlignment="Top" IsVisible="{Binding SelectedBoiler, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <!-- Maintenance start time -->
                        <StackPanel Grid.Column="0" Spacing="8" Margin="0,0,40,20" VerticalAlignment="Top">
                          <TextBlock Text="Maintenance Start" FontSize="14" Foreground="{DynamicResource AppTextPrimary}" FontWeight="SemiBold"/>
                          <WrapPanel Margin="0">
                            <CalendarDatePicker SelectedDate="{Binding MaintenanceStartDate, Mode=TwoWay}" Width="140" Watermark="Select date" Margin="0,0,10,0"/>
                            <NumericUpDown Minimum="0" Maximum="23" Value="{Binding MaintenanceStartHour, Mode=TwoWay}" FormatString="00" Margin="0" VerticalAlignment="Center" Width="70" ShowButtonSpinner="True"/>
                            <TextBlock Text="{Binding MaintenanceStartHour, StringFormat={}{0:00}}" VerticalAlignment="Center" Margin="8,0,0,0" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimary}"/>
                            <TextBlock Text=": 00" VerticalAlignment="Center" Margin="5,0,0,0" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimary}"/>
                          </WrapPanel>
                        </StackPanel>

                        <!-- Maintenance duration -->
                        <StackPanel Grid.Column="1" Spacing="8" Margin="0,0,20,20" VerticalAlignment="Top">
                          <TextBlock Text="Maintenance Duration" FontSize="14" Foreground="{DynamicResource AppTextPrimary}" FontWeight="SemiBold"/>
                          <Grid Margin="0" ColumnDefinitions="140,Auto,Auto" VerticalAlignment="Center">
                            <Slider Grid.Column="0" Minimum="30" Maximum="60" Value="{Binding MaintenanceDuration, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding MaintenanceDuration}" VerticalAlignment="Center" Margin="10,0,0,0" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimary}"/>
                            <TextBlock Grid.Column="2" Text="hours" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource AppTextMuted}"/>
                          </Grid>
                        </StackPanel>

                        <!-- Confirm Maintenance Button -->
                        <Button Grid.Column="2"
                            HorizontalAlignment="Right"
                          Command="{Binding ScheduleMaintenanceCommand}"
                          Content="Select"
                                FontWeight="SemiBold"
                                CornerRadius="4"
                                Padding="16,8"
                                VerticalAlignment="Bottom"
                                Margin="0,0,0,20">
                            <Button.Styles>
                              <!-- Default state -->
                              <Style Selector="Button">
                                <Setter Property="Background" Value="#3B82F6"/>
                                <Setter Property="Foreground" Value="White"/>
                              </Style>
                              <!-- Hover state, because default made the button not visible -->
                              <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="#2563EB"/>
                                <Setter Property="TextBlock.Foreground" Value="White"/>
                              </Style>
                            </Button.Styles>
                          </Button>
                      </Grid>

                        <TextBlock VerticalAlignment="Bottom"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppTextPrimary}"
                                   Text="Maintenance Schedule"
                                   Margin="0,20,10,0" />

                        <!-- Maintenance Table -->
                        <Border Margin="0,0,0,10" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="4" Padding="10" Background="{DynamicResource AppCard}" BoxShadow="0 4 10 0 #33000000">
                          <!-- Bindings to the OptimizationView -->
                          <Grid Margin="10" RowDefinitions="Auto,Auto,*" ColumnDefinitions="*,*,*,*,*">

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Asset Name" FontWeight="Bold" Margin="10" Foreground="{DynamicResource AppTextPrimary}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="From (Date)" FontWeight="Bold" Margin="10" Foreground="{DynamicResource AppTextPrimary}"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="To (Date)" FontWeight="Bold" Margin="10" Foreground="{DynamicResource AppTextPrimary}"/>
                            <TextBlock Grid.Row="0" Grid.Column="3" Text="Period" FontWeight="Bold" Margin="10" Foreground="{DynamicResource AppTextPrimary}"/>
                            <TextBlock Grid.Row="0" Grid.Column="4" Text="Scenario" FontWeight="Bold" Margin="10" Foreground="{DynamicResource AppTextPrimary}"/>

                            <!-- Line separating rows -->
                            <Rectangle Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5" Height="1" Fill="{DynamicResource AppBorder}" VerticalAlignment="Bottom"/>

                            <ItemsControl ItemsSource="{Binding Schedules}" Grid.Row="2" Grid.ColumnSpan="5">
                              <ItemsControl.ItemTemplate>
                              <DataTemplate x:CompileBindings="False">
                                  <Grid ColumnDefinitions="*,*,*,*,*">
                                    <TextBlock Grid.Column="0" Text="{Binding AssetName}" Margin="10" Foreground="{DynamicResource AppTextPrimary}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding StartDate, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Margin="10" Foreground="{DynamicResource AppTextPrimary}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding EndDate, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Margin="10" Foreground="{DynamicResource AppTextPrimary}"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Period}" Margin="10" Foreground="{DynamicResource AppTextPrimary}"/>
                                    <TextBlock Grid.Column="4" Text="{Binding Scenario}" Margin="10" Foreground="{DynamicResource AppTextPrimary}"/>
                                  </Grid>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </Grid>
                        </Border>

                        <!-- Heat demand graph SUMMER -->
                        <Border Margin="0,20,0,0"
                                Background="{DynamicResource AppCardInner}"
                                BorderBrush="{DynamicResource AppBorder}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                          <StackPanel Spacing="12">
                            <TextBlock Text="Heat Demand"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AppTextPrimary}" />

                            <Grid Height="260">
                              <lvc:CartesianChart
                                                  x:Name="SummerHeatDemandChartScenario2"
                                                  Background="{DynamicResource AppBackground}"
                                                  ZoomMode="None"
                                                  Margin="0">
                              </lvc:CartesianChart>
                            </Grid>
                          </StackPanel>
                        </Border>

                        <!-- Electricity price graph SUMMER -->
                        <Border Margin="0,16,0,0"
                                Background="{DynamicResource AppCardInner}"
                                BorderBrush="{DynamicResource AppBorder}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                          <StackPanel Spacing="12">
                            <TextBlock Text="Electricity Price"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AppTextPrimary}" />

                            <Grid Height="260">
                              <lvc:CartesianChart
                                                  x:Name="SummerElectricityPriceChartScenario2"
                                                  Background="{DynamicResource AppBackground}"
                                                  ZoomMode="None"
                                                  Margin="0">
                              </lvc:CartesianChart>
                            </Grid>

                            <TextBlock Text="The Price is set in DKK per MWh(el)."
                                       FontSize="14"
                                       Foreground="{DynamicResource AppTextMuted}"
                                       TextWrapping="Wrap" />
                          </StackPanel>
                        </Border>

                        <!-- Optimisation Status -->
                        <StackPanel IsVisible="{Binding IsOptimising}" Margin="0,20,0,0" HorizontalAlignment="Center">
                          <TextBlock Text="Running optimisation, this may take a moment..." FontSize="14" Foreground="{DynamicResource AppTextMuted}" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock IsVisible="{Binding OptimisationStatusMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
                                   Text="{Binding OptimisationStatusMessage}"
                                   FontSize="14"
                                   Foreground="#EF4444"
                                   Margin="0,10,0,0"
                                   TextWrapping="Wrap"/>

                        <!-- Optimisation Results -->
                        <Border IsVisible="{Binding HasOptimisationResults}"
                                Margin="0,20,0,0"
                                Background="{DynamicResource AppCard}"
                                BoxShadow="0 4 10 0 #33000000"
                                CornerRadius="8"
                                Padding="20">
                          <StackPanel>
                            <TextBlock Text="Optimisation Results"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AppTextPrimary}"
                                       Margin="0,0,0,16"/>

                            <!-- Summary cards -->
                            <Grid ColumnDefinitions="*,*,*" Margin="0,0,0,20">
                              <Border Grid.Column="0" Background="{DynamicResource AppCardInner}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,8,0">
                                <StackPanel>
                                  <TextBlock Text="Total Heat Production" FontSize="12" Foreground="{DynamicResource AppTextMuted}" Margin="0,0,0,4"/>
                                  <TextBlock Text="{Binding TotalHeatProduction, StringFormat='{}{0:F2} MWh'}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}"/>
                                </StackPanel>
                              </Border>
                              <Border Grid.Column="1" Background="{DynamicResource AppCardInner}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="4,0,4,0">
                                <StackPanel>
                                  <TextBlock Text="Total Expenses" FontSize="12" Foreground="{DynamicResource AppTextMuted}" Margin="0,0,0,4"/>
                                  <TextBlock Text="{Binding TotalExpenses, StringFormat='{}{0:F2} DKK'}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}"/>
                                </StackPanel>
                              </Border>
                              <Border Grid.Column="2" Background="{DynamicResource AppCardInner}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="8,0,0,0">
                                <StackPanel>
                                  <TextBlock Text="Total CO2 Emissions" FontSize="12" Foreground="{DynamicResource AppTextMuted}" Margin="0,0,0,4"/>
                                  <TextBlock Text="{Binding TotalCo2Emissions, StringFormat='{}{0:F2} kg'}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}"/>
                                </StackPanel>
                              </Border>
                            </Grid>

                            <!-- Hourly results table -->
                            <Border Background="{DynamicResource AppCardInner}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="8" Padding="10">
                              <StackPanel>
                                <Grid ColumnDefinitions="2*,1*,1*,1*,1*" Margin="10,5,10,10">
                                  <TextBlock Grid.Column="0" Text="Time" FontWeight="Bold" Foreground="{DynamicResource AppTextMuted}"/>
                                  <TextBlock Grid.Column="1" Text="Heat (MWh)" FontWeight="Bold" Foreground="{DynamicResource AppTextMuted}"/>
                                  <TextBlock Grid.Column="2" Text="Electricity (MWh)" FontWeight="Bold" Foreground="{DynamicResource AppTextMuted}"/>
                                  <TextBlock Grid.Column="3" Text="Expenses (DKK)" FontWeight="Bold" Foreground="{DynamicResource AppTextMuted}"/>
                                  <TextBlock Grid.Column="4" Text="CO2 (kg)" FontWeight="Bold" Foreground="{DynamicResource AppTextMuted}"/>
                                </Grid>
                                <Separator Background="{DynamicResource AppBorder}" Height="1" Margin="0,0,0,5"/>
                                <ItemsControl ItemsSource="{Binding OptimisationResults}">
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate x:CompileBindings="False">
                                      <Grid ColumnDefinitions="2*,1*,1*,1*,1*" Margin="10,6">
                                        <TextBlock Grid.Column="0" Text="{Binding TimeFrom, StringFormat='{}{0:dd MMM HH:mm}'}" Foreground="{DynamicResource AppTextPrimary}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding HeatProduction, StringFormat='{}{0:F2}'}" Foreground="{DynamicResource AppTextPrimary}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding ElectricityConsumption, StringFormat='{}{0:F2}'}" Foreground="{DynamicResource AppTextPrimary}"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Expenses, StringFormat='{}{0:F2}'}" Foreground="{DynamicResource AppTextPrimary}"/>
                                        <TextBlock Grid.Column="4" Text="{Binding Co2Emissions, StringFormat='{}{0:F2}'}" Foreground="{DynamicResource AppTextPrimary}"/>
                                      </Grid>
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>
                              </StackPanel>
                            </Border>
                          </StackPanel>
                        </Border>

                    </StackPanel>

                    <!-- Stackpanel for Winter view-->
                    <StackPanel Margin="10" DataContext="{Binding WinterScenario2}">
                      <Grid ColumnDefinitions="Auto,Auto,*" Margin="0,0,0,20">

                        <!-- Period Start Date -->
                        <StackPanel Grid.Column="0" Spacing="8" Margin="0,0,20,20">
                          <TextBlock Text="Start Date" FontSize="14" Foreground="{DynamicResource AppTextPrimary}" FontWeight="SemiBold"/>
                          <Border Background="{DynamicResource AppInputBackground}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="2" CornerRadius="4" Padding="10,8" MaxWidth="250">
                            <TextBlock Text="05/01/2026 - 00:00" Foreground="{DynamicResource AppTextPrimary}" VerticalAlignment="Center" />
                          </Border>
                        </StackPanel>

                        <!-- Period End Date -->
                        <StackPanel Grid.Column="1" Spacing="8" Margin="0,0,20,20">
                          <TextBlock Text="End Date" FontSize="14" Foreground="{DynamicResource AppTextPrimary}" FontWeight="SemiBold"/>
                          <Border Background="{DynamicResource AppInputBackground}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="2" CornerRadius="4" Padding="10,8" MaxWidth="250">
                            <TextBlock Text="18/01/2026 - 23:59" Foreground="{DynamicResource AppTextPrimary}" VerticalAlignment="Center" />

                          </Border>
                        </StackPanel>

                        <!-- Optimize button to start optimization -->
                        <Button Grid.Column="2"
                                Command="{Binding RunOptimisationCommand}"
                                Content="Optimize"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Margin="0,0,0,20"
                                Padding="18,8"
                                FontWeight="SemiBold"
                                CornerRadius="4">
                          <Button.Styles>
                            <Style Selector="Button">
                              <Setter Property="Background" Value="#16A34A" />
                              <Setter Property="Foreground" Value="White" />
                            </Style>

                            <!-- hover to make it more appealing -->
                            <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                              <Setter Property="Background" Value="#15803D" />
                              <Setter Property="TextBlock.Foreground" Value="White" />
                            </Style>
                          </Button.Styles>
                        </Button>
                      </Grid>

                      <TextBlock VerticalAlignment="Bottom"
                                 FontSize="18"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource AppTextPrimary}"
                                 Text="Schedule Maintenance"
                                 Margin="0,20,10,0"/>
                      <TextBlock VerticalAlignment="Bottom"
                                 FontSize="14"
                                 Foreground="{DynamicResource AppTextPrimary}"
                                 TextWrapping="Wrap"
                                 Text="Click on a unit to mark it for maintenance. Select a time interval lasting 30-60 hours. The interval has to be during the Winter Period."
                                 Margin="0,0,10,10"/>

                      <!-- Selectable Table for Boilers using ListBox -->
                      <Border Background="{DynamicResource AppCardInner}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="8" Padding="10">
                        <StackPanel>
                          <!-- Table names -->
                          <Grid ColumnDefinitions="2*, 1*, 1*" Margin="10,5,10,10">
                            <TextBlock Grid.Column="0" Text="Boiler ID" FontWeight="Bold" Foreground="{DynamicResource AppTextMuted}" />
                            <TextBlock Grid.Column="1" Text="Fuel Type" FontWeight="Bold" Foreground="{DynamicResource AppTextMuted}" />
                            <TextBlock Grid.Column="2" Text="Status" FontWeight="Bold" Foreground="{DynamicResource AppTextMuted}" />
                          </Grid>

                          <Separator Background="{DynamicResource AppBorder}" Height="1" Margin="0,0,0,5" />

                          <!-- Selectable rows for maintenance -->
                          <ListBox ItemsSource="{Binding Boilers}" SelectedItem="{Binding SelectedBoiler, Mode=TwoWay}" Background="Transparent" BorderThickness="0" CornerRadius="4">
                            <ListBox.Styles>
                              <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                              </Style>
                            </ListBox.Styles>
                            <ListBox.ItemTemplate>
                              <DataTemplate x:CompileBindings="False">
                                <Grid ColumnDefinitions="2*, 1*, 1*" Margin="10">
                                  <TextBlock Grid.Column="0" Text="{Binding BoilerId}" Foreground="{DynamicResource AppTextPrimary}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                  <TextBlock Grid.Column="1" Text="{Binding FuelType}" Foreground="{DynamicResource AppTextPrimary}" VerticalAlignment="Center"/>
                                  <TextBlock Grid.Column="2" Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" VerticalAlignment="Center"/>
                                </Grid>
                              </DataTemplate>
                            </ListBox.ItemTemplate>
                          </ListBox>
                        </StackPanel>
                      </Border>

                      <!-- Maintenance Date choosing -->
                      <Grid ColumnDefinitions="Auto, Auto, *" Margin="0,20,0,0" VerticalAlignment="Top" IsVisible="{Binding SelectedBoiler, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <!-- Maintenance start time -->
                        <StackPanel Grid.Column="0" Spacing="8" Margin="0,0,40,20" VerticalAlignment="Top">
                          <TextBlock Text="Maintenance Start" FontSize="14" Foreground="{DynamicResource AppTextPrimary}" FontWeight="SemiBold"/>
                          <WrapPanel Margin="0">
                            <CalendarDatePicker SelectedDate="{Binding MaintenanceStartDate, Mode=TwoWay}" Width="140" Watermark="Select date" Margin="0,0,10,0" />
                            <NumericUpDown Minimum="0" Maximum="23" Value="{Binding MaintenanceStartHour, Mode=TwoWay}" FormatString="00" Margin="0" VerticalAlignment="Center" Width="70" ShowButtonSpinner="True"/>
                            <TextBlock Text="{Binding MaintenanceStartHour, StringFormat={}{0:00}}" VerticalAlignment="Center" Margin="8,0,0,0" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimary}"/>
                            <TextBlock Text=": 00" VerticalAlignment="Center" Margin="5,0,0,0" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimary}"/>
                          </WrapPanel>
                        </StackPanel>

                        <!-- Maintenance duration -->
                        <StackPanel Grid.Column="1" Spacing="8" Margin="0,0,20,20" VerticalAlignment="Top">
                          <TextBlock Text="Maintenance Duration" FontSize="14" Foreground="{DynamicResource AppTextPrimary}" FontWeight="SemiBold"/>
                          <Grid Margin="0" ColumnDefinitions="140,Auto,Auto" VerticalAlignment="Center">
                            <Slider Grid.Column="0" Minimum="30" Maximum="60" Value="{Binding MaintenanceDuration, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding MaintenanceDuration}" VerticalAlignment="Center" Margin="10,0,0,0" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimary}"/>
                            <TextBlock Grid.Column="2" Text="hours" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource AppTextMuted}"/>
                          </Grid>
                        </StackPanel>

                        <!-- Confirm Maintenance Button -->
                        <Button Grid.Column="2"
                            HorizontalAlignment="Right"
                          Command="{Binding ScheduleMaintenanceCommand}"
                          Content="Select"
                                FontWeight="SemiBold"
                                CornerRadius="4"
                                Padding="16,8"
                                VerticalAlignment="Bottom"
                                Margin="0,0,0,20">
                          <Button.Styles>
                            <!-- Default state -->
                            <Style Selector="Button">
                              <Setter Property="Background" Value="#3B82F6"/>
                              <Setter Property="Foreground" Value="White"/>
                            </Style>
                            <!-- Hover state, because default made the button not visible -->
                            <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                              <Setter Property="Background" Value="#2563EB"/>
                              <Setter Property="TextBlock.Foreground" Value="White"/>
                            </Style>
                          </Button.Styles>
                        </Button>
                      </Grid>

                      <TextBlock VerticalAlignment="Bottom"
                                 FontSize="18"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource AppTextPrimary}"
                                 Text="Maintenance Schedule"
                                 Margin="0,20,10,0" />

                      <!-- Maintenance Table -->
                      <Border Margin="0,0,0,10" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="4" Padding="10" Background="{DynamicResource AppCard}" BoxShadow="0 4 10 0 #33000000">
                        <!-- Bindings to the OptimizationView -->
                        <Grid Margin="10" RowDefinitions="Auto,Auto,*" ColumnDefinitions="*,*,*,*,*">

                          <TextBlock Grid.Row="0" Grid.Column="0" Text="Asset Name" FontWeight="Bold" Margin="10" Foreground="{DynamicResource AppTextPrimary}"/>
                          <TextBlock Grid.Row="0" Grid.Column="1" Text="From (Date)" FontWeight="Bold" Margin="10" Foreground="{DynamicResource AppTextPrimary}"/>
                          <TextBlock Grid.Row="0" Grid.Column="2" Text="To (Date)" FontWeight="Bold" Margin="10" Foreground="{DynamicResource AppTextPrimary}"/>
                          <TextBlock Grid.Row="0" Grid.Column="3" Text="Period" FontWeight="Bold" Margin="10" Foreground="{DynamicResource AppTextPrimary}"/>
                          <TextBlock Grid.Row="0" Grid.Column="4" Text="Scenario" FontWeight="Bold" Margin="10" Foreground="{DynamicResource AppTextPrimary}"/>

                          <!-- Line separating rows -->
                          <Rectangle Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5" Height="1" Fill="{DynamicResource AppBorder}" VerticalAlignment="Bottom"/>

                            <ItemsControl ItemsSource="{Binding Schedules}" Grid.Row="2" Grid.ColumnSpan="5">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:CompileBindings="False">
                                <Grid ColumnDefinitions="*,*,*,*,*">
                                  <TextBlock Grid.Column="0" Text="{Binding AssetName}" Margin="10" Foreground="{DynamicResource AppTextPrimary}"/>
                                  <TextBlock Grid.Column="1" Text="{Binding StartDate, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Margin="10" Foreground="{DynamicResource AppTextPrimary}"/>
                                  <TextBlock Grid.Column="2" Text="{Binding EndDate, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Margin="10" Foreground="{DynamicResource AppTextPrimary}"/>
                                  <TextBlock Grid.Column="3" Text="{Binding Period}" Margin="10" Foreground="{DynamicResource AppTextPrimary}"/>
                                  <TextBlock Grid.Column="4" Text="{Binding Scenario}" Margin="10" Foreground="{DynamicResource AppTextPrimary}"/>
                                </Grid>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </Grid>
                      </Border>

                      <!-- Heat demand graph for the winter maintenance process -->
                      <Border Margin="0,20,0,0"
                              Background="{DynamicResource AppCardInner}"
                              BorderBrush="{DynamicResource AppBorder}"
                              BorderThickness="1"
                              CornerRadius="8"
                              Padding="16">
                        <StackPanel Spacing="12">
                          <TextBlock Text="Heat Demand"
                                     FontSize="18"
                                     FontWeight="SemiBold"
                                     Foreground="{DynamicResource AppTextPrimary}" />

                          <Grid Height="260">
                            <lvc:CartesianChart
                                                x:Name="WinterHeatDemandChartScenario2"
                                                Background="{DynamicResource AppBackground}"
                                                ZoomMode="None"
                                                Margin="0">
                            </lvc:CartesianChart>
                          </Grid>
                        </StackPanel>
                      </Border>

                      <Border Margin="0,16,0,0"
                              Background="{DynamicResource AppCardInner}"
                              BorderBrush="{DynamicResource AppBorder}"
                              BorderThickness="1"
                              CornerRadius="8"
                              Padding="16">
                        <StackPanel Spacing="12">
                          <TextBlock Text="Electricity Price"
                                     FontSize="18"
                                     FontWeight="SemiBold"
                                     Foreground="{DynamicResource AppTextPrimary}" />

                          <Grid Height="260">
                            <lvc:CartesianChart
                                                x:Name="WinterElectricityPriceChartScenario2"
                                                Background="{DynamicResource AppBackground}"
                                                ZoomMode="None"
                                                Margin="0">
                            </lvc:CartesianChart>
                          </Grid>

                          <TextBlock Text="The Price is set in DKK per MWh(el)."
                                     FontSize="14"
                                     Foreground="{DynamicResource AppTextMuted}"
                                     TextWrapping="Wrap" />
                        </StackPanel>
                      </Border>

                      <!-- Optimisation Status -->
                      <StackPanel IsVisible="{Binding IsOptimising}" Margin="0,20,0,0" HorizontalAlignment="Center">
                        <TextBlock Text="Running optimisation, this may take a moment..." FontSize="14" Foreground="{DynamicResource AppTextMuted}" HorizontalAlignment="Center"/>
                      </StackPanel>

                      <TextBlock IsVisible="{Binding OptimisationStatusMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
                                 Text="{Binding OptimisationStatusMessage}"
                                 FontSize="14"
                                 Foreground="#EF4444"
                                 Margin="0,10,0,0"
                                 TextWrapping="Wrap"/>

                      <!-- Optimisation Results -->
                      <Border IsVisible="{Binding HasOptimisationResults}"
                              Margin="0,20,0,0"
                              Background="{DynamicResource AppCard}"
                              BoxShadow="0 4 10 0 #33000000"
                              CornerRadius="8"
                              Padding="20">
                        <StackPanel>
                          <TextBlock Text="Optimisation Results"
                                     FontSize="18"
                                     FontWeight="SemiBold"
                                     Foreground="{DynamicResource AppTextPrimary}"
                                     Margin="0,0,0,16"/>

                          <!-- Summary cards -->
                          <Grid ColumnDefinitions="*,*,*" Margin="0,0,0,20">
                            <Border Grid.Column="0" Background="{DynamicResource AppCardInner}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,8,0">
                              <StackPanel>
                                <TextBlock Text="Total Heat Production" FontSize="12" Foreground="{DynamicResource AppTextMuted}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding TotalHeatProduction, StringFormat='{}{0:F2} MWh'}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}"/>
                              </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="{DynamicResource AppCardInner}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="4,0,4,0">
                              <StackPanel>
                                <TextBlock Text="Total Expenses" FontSize="12" Foreground="{DynamicResource AppTextMuted}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding TotalExpenses, StringFormat='{}{0:F2} DKK'}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}"/>
                              </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="{DynamicResource AppCardInner}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="8,0,0,0">
                              <StackPanel>
                                <TextBlock Text="Total CO2 Emissions" FontSize="12" Foreground="{DynamicResource AppTextMuted}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding TotalCo2Emissions, StringFormat='{}{0:F2} kg'}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}"/>
                              </StackPanel>
                            </Border>
                          </Grid>

                          <!-- Hourly results table -->
                          <Border Background="{DynamicResource AppCardInner}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="8" Padding="10">
                            <StackPanel>
                              <Grid ColumnDefinitions="2*,1*,1*,1*,1*" Margin="10,5,10,10">
                                <TextBlock Grid.Column="0" Text="Time" FontWeight="Bold" Foreground="{DynamicResource AppTextMuted}"/>
                                <TextBlock Grid.Column="1" Text="Heat (MWh)" FontWeight="Bold" Foreground="{DynamicResource AppTextMuted}"/>
                                <TextBlock Grid.Column="2" Text="Electricity (MWh)" FontWeight="Bold" Foreground="{DynamicResource AppTextMuted}"/>
                                <TextBlock Grid.Column="3" Text="Expenses (DKK)" FontWeight="Bold" Foreground="{DynamicResource AppTextMuted}"/>
                                <TextBlock Grid.Column="4" Text="CO2 (kg)" FontWeight="Bold" Foreground="{DynamicResource AppTextMuted}"/>
                              </Grid>
                              <Separator Background="{DynamicResource AppBorder}" Height="1" Margin="0,0,0,5"/>
                              <ItemsControl ItemsSource="{Binding OptimisationResults}">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate x:CompileBindings="False">
                                    <Grid ColumnDefinitions="2*,1*,1*,1*,1*" Margin="10,6">
                                      <TextBlock Grid.Column="0" Text="{Binding TimeFrom, StringFormat='{}{0:dd MMM HH:mm}'}" Foreground="{DynamicResource AppTextPrimary}"/>
                                      <TextBlock Grid.Column="1" Text="{Binding HeatProduction, StringFormat='{}{0:F2}'}" Foreground="{DynamicResource AppTextPrimary}"/>
                                      <TextBlock Grid.Column="2" Text="{Binding ElectricityConsumption, StringFormat='{}{0:F2}'}" Foreground="{DynamicResource AppTextPrimary}"/>
                                      <TextBlock Grid.Column="3" Text="{Binding Expenses, StringFormat='{}{0:F2}'}" Foreground="{DynamicResource AppTextPrimary}"/>
                                      <TextBlock Grid.Column="4" Text="{Binding Co2Emissions, StringFormat='{}{0:F2}'}" Foreground="{DynamicResource AppTextPrimary}"/>
                                    </Grid>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </StackPanel>
                          </Border>
                        </StackPanel>
                      </Border>

                    </StackPanel>

                  </Carousel.Items>
                </Carousel>
              </Grid>
            </Border>
          </StackPanel>

          </Carousel.Items>
      </Carousel>

    </Grid>

  </ScrollViewer>
</UserControl>
