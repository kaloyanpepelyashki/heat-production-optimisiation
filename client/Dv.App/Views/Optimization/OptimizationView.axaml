<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:system="using:System"
             x:Class="Dv.App.Views.OptimizationView">


  <ScrollViewer>
    <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto, Auto" Margin="0">


      <!-- Stackpanel for upper rectangle -->
      <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0">
        <Border Background="{DynamicResource AppCard}"
                BoxShadow="0 4 10 0 #33000000"
                CornerRadius="8"
                Margin="10,0,10,10"
                Padding="20">
          <Grid VerticalAlignment="Top">
            <TextBlock HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       FontSize="28"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource AppTextPrimary}"
                       Text="Optimization"
                       Margin="10" />


            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="10">
              <TextBlock VerticalAlignment="Center"
                         FontSize="14"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource AppTextPrimary}"
                         Text="Choose Scenario: "
                         Margin="0,0,10,0" />
              <!-- Dropdown menu -->
              <ComboBox x:Name="ScenarioComboBox" SelectedIndex="0" Width="150">
                <ComboBoxItem Content="Scenario 1" />
                <ComboBoxItem Content="Scenario 2" />
              </ComboBox>
            </StackPanel>
          </Grid>
        </Border>
      </StackPanel>

      <!-- The view that changes based on the scenario selection -->
      <Carousel Grid.Row="1" Grid.ColumnSpan="2" SelectedIndex="{Binding #ScenarioComboBox.SelectedIndex}" Margin="10">
        <Carousel.Items>

          <!-- Scenario 1 View -->
          <StackPanel>
            <Border Padding="20">
              <TextBlock Text="Scenario 1" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimary}" HorizontalAlignment="Center" />
            </Border>

            <Border Background="{DynamicResource AppCard}"
                    BoxShadow="0 4 10 0 #33000000"
                    CornerRadius="8"
                    Margin="10,0,10,10"
                    Padding="20">


              <Grid VerticalAlignment="Top" RowDefinitions="Auto,Auto">
                <TextBlock Grid.Row="0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AppTextPrimary}"
                           Text="Optimization Period"
                           Margin="10" />

                <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="10">
                  <TextBlock VerticalAlignment="Center"
                             FontSize="14"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource AppTextPrimary}"
                             Text="Choose Period: "
                             Margin="0,0,10,0" />
                  <!-- Dropdown menu periods-->
                  <ComboBox x:Name="PeriodComboBox" SelectedIndex="0" Width="150">
                    <ComboBoxItem Content="Summer" />
                    <ComboBoxItem Content="Winter" />
                  </ComboBox>
                </StackPanel>


                <!-- Grid for two periods -->
                <Carousel Grid.Row="1" SelectedIndex="{Binding #PeriodComboBox.SelectedIndex}" Margin="10,20,10,10">
                  <Carousel.Items>


                    <!-- Stackpanel for Summer view-->
                    <StackPanel Margin="10">
                      <StackPanel Orientation="Horizontal" Spacing="40">

                        <!-- Period Start Date -->
                        <StackPanel Spacing="8">
                          <TextBlock Text="Start Date" FontSize="14" Foreground="{DynamicResource AppTextPrimary}" FontWeight="SemiBold"/>
                          <Border Background="{DynamicResource AppInputBackground}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="2" CornerRadius="4" Padding="10,8" Width="200">
                            <TextBlock Text="08/09/2025 - 00:00" Foreground="{DynamicResource AppTextPrimary}" VerticalAlignment="Center" />
                          </Border>
                        </StackPanel>

                        <!-- Period End Date -->
                        <StackPanel Spacing="8">
                          <TextBlock Text="End Date" FontSize="14" Foreground="{DynamicResource AppTextPrimary}" FontWeight="SemiBold"/>
                          <Border Background="{DynamicResource AppInputBackground}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="2" CornerRadius="4" Padding="10,8" Width="200">
                            <TextBlock Text="21/09/2025 - 23:59" Foreground="{DynamicResource AppTextPrimary}" VerticalAlignment="Center" />

                          </Border>
                        </StackPanel>
                      </StackPanel>

                      <TextBlock VerticalAlignment="Bottom"
                                 FontSize="18"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource AppTextPrimary}"
                                 Text="Schedule Maintenance"
                                 Margin="0,20,10,0"/>
                      <TextBlock VerticalAlignment="Bottom"
                                 FontSize="14"
                                 Foreground="{DynamicResource AppTextPrimary}"
                                 TextWrapping="Wrap"
                                 Text="Click on a unit to mark it for maintenance. Select a time interval lasting 30-60 hours. The interval has to be during the Summer Period."
                                 Margin="0,0,10,10"/>

                      <!-- Selectable Table for Boilers using ListBox -->
                      <Border Background="{DynamicResource AppCardInner}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="8" Padding="10">
                        <StackPanel>
                          <!-- Table names -->
                          <Grid ColumnDefinitions="2*, 1*, 1*" Margin="10,5,10,10">
                            <TextBlock Grid.Column="0" Text="Boiler ID" FontWeight="Bold" Foreground="{DynamicResource AppTextMuted}" />
                            <TextBlock Grid.Column="1" Text="Fuel Type" FontWeight="Bold" Foreground="{DynamicResource AppTextMuted}" />
                            <TextBlock Grid.Column="2" Text="Status" FontWeight="Bold" Foreground="{DynamicResource AppTextMuted}" />
                          </Grid>

                          <Separator Background="{DynamicResource AppBorder}" Height="1" Margin="0,0,0,5" />

                          <!-- Selectable rows for maintenance -->
                          <ListBox x:Name="BoilersListBoxSummer" Background="Transparent" BorderThickness="0" CornerRadius="4">
                            <!-- GB1 -->
                            <ListBoxItem Padding="10" Tag="GB1">
                              <Grid ColumnDefinitions="2*, 1*, 1*">
                                <TextBlock Grid.Column="0" Text="GB1" Foreground="{DynamicResource AppTextPrimary}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Gas" Foreground="{DynamicResource AppTextPrimary}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="Active" Foreground="#10B981" VerticalAlignment="Center"/>
                              </Grid>
                            </ListBoxItem>

                            <!-- GB2 -->
                            <ListBoxItem Padding="10" Tag="GB2">
                              <Grid ColumnDefinitions="2*, 1*, 1*">
                                <TextBlock Grid.Column="0" Text="GB2" Foreground="{DynamicResource AppTextPrimary}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Gas" Foreground="{DynamicResource AppTextPrimary}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="Active" Foreground="#10B981" VerticalAlignment="Center"/>
                              </Grid>
                            </ListBoxItem>

                            <!-- GB3 -->
                            <ListBoxItem Padding="10" Tag="GB3">
                              <Grid ColumnDefinitions="2*, 1*, 1*">
                                <TextBlock Grid.Column="0" Text="GB3" Foreground="{DynamicResource AppTextPrimary}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Gas" Foreground="{DynamicResource AppTextPrimary}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="Active" Foreground="#10B981" VerticalAlignment="Center"/>
                              </Grid>
                            </ListBoxItem>

                            <!-- OB1 -->
                            <ListBoxItem Padding="10" Tag="OB1">
                              <Grid ColumnDefinitions="2*, 1*, 1*">
                                <TextBlock Grid.Column="0" Text="OB1" Foreground="{DynamicResource AppTextPrimary}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Oil" Foreground="{DynamicResource AppTextPrimary}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="Active" Foreground="#10B981" VerticalAlignment="Center"/>
                              </Grid>
                            </ListBoxItem>
                          </ListBox>
                        </StackPanel>
                      </Border>

                      <!-- Maintenance Date choosing -->
                      <Grid ColumnDefinitions="Auto, Auto, *" Margin="0,20,0,0">
                        <!-- Maintenance start time -->
                        <StackPanel Grid.Column="0" Spacing="8" Margin="0,0,40,0">
                          <TextBlock Text="Maintenance Start" FontSize="14" Foreground="{DynamicResource AppTextPrimary}" FontWeight="SemiBold"/>
                          <StackPanel Orientation="Horizontal" Spacing="10">
                            <CalendarDatePicker x:Name="MaintenanceStartDatePickerSummer" Width="140" Watermark="Select date" />
                            <TimePicker x:Name="MaintenanceStartTimePickerSummer" />
                          </StackPanel>
                        </StackPanel>

                        <!-- Maintenance end time -->
                        <StackPanel Grid.Column="1" Spacing="8">
                          <TextBlock Text="Maintenance End" FontSize="14" Foreground="{DynamicResource AppTextPrimary}" FontWeight="SemiBold"/>
                          <StackPanel Orientation="Horizontal" Spacing="10">
                            <CalendarDatePicker x:Name="MaintenanceEndDatePickerSummer" Width="140" Watermark="Select date" />
                            <TimePicker x:Name="MaintenanceEndTimePickerSummer" />
                          </StackPanel>
                        </StackPanel>

                        <!-- Confirm Maintenance Button -->
                        <Button Grid.Column="2" HorizontalAlignment="Right"
                                Click="ConfirmMaintenanceSummer_Click"
                                Content="Confirm Maintenance"
                                FontWeight="SemiBold"
                                CornerRadius="4"
                                Padding="16,8"
                                VerticalAlignment="Bottom"
                                Margin="0,0,0,2">
                            <Button.Styles>
                              <!-- Default state -->
                              <Style Selector="Button">
                                <Setter Property="Background" Value="#3B82F6"/>
                                <Setter Property="Foreground" Value="White"/>
                              </Style>
                              <!-- Hover state, because default made the button not visible -->
                              <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="#2563EB"/>
                                <Setter Property="TextBlock.Foreground" Value="White"/>
                              </Style>
                            </Button.Styles>
                          </Button>
                      </Grid>

                    </StackPanel>

                    <!-- Stackpanel for Winter view-->
                    <StackPanel Margin="10">
                      <StackPanel Orientation="Horizontal" Spacing="40">

                        <!-- Period Start Date -->
                        <StackPanel Spacing="8">
                          <TextBlock Text="Start Date" FontSize="14" Foreground="{DynamicResource AppTextPrimary}" FontWeight="SemiBold"/>
                          <Border Background="{DynamicResource AppInputBackground}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="2" CornerRadius="4" Padding="10,8" Width="200">
                            <TextBlock Text="05/01/2026 - 00:00" Foreground="{DynamicResource AppTextPrimary}" VerticalAlignment="Center" />
                          </Border>
                        </StackPanel>

                        <!-- Period End Date -->
                        <StackPanel Spacing="8">
                          <TextBlock Text="End Date" FontSize="14" Foreground="{DynamicResource AppTextPrimary}" FontWeight="SemiBold"/>
                          <Border Background="{DynamicResource AppInputBackground}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="2" CornerRadius="4" Padding="10,8" Width="200">
                            <TextBlock Text="18/01/2026 - 23:59" Foreground="{DynamicResource AppTextPrimary}" VerticalAlignment="Center" />

                          </Border>
                        </StackPanel>
                      </StackPanel>

                      <TextBlock VerticalAlignment="Bottom"
                                 FontSize="18"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource AppTextPrimary}"
                                 Text="Schedule Maintenance"
                                 Margin="0,20,10,0"/>
                      <TextBlock VerticalAlignment="Bottom"
                                 FontSize="14"
                                 Foreground="{DynamicResource AppTextPrimary}"
                                 TextWrapping="Wrap"
                                 Text="Click on a unit to mark it for maintenance. Select a time interval lasting 30-60 hours. The interval has to be during the Winter Period."
                                 Margin="0,0,10,10"/>

                      <!-- Selectable Table for Boilers using ListBox -->
                      <Border Background="{DynamicResource AppCardInner}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="8" Padding="10">
                        <StackPanel>
                          <!-- Table names -->
                          <Grid ColumnDefinitions="2*, 1*, 1*" Margin="10,5,10,10">
                            <TextBlock Grid.Column="0" Text="Boiler ID" FontWeight="Bold" Foreground="{DynamicResource AppTextMuted}" />
                            <TextBlock Grid.Column="1" Text="Fuel Type" FontWeight="Bold" Foreground="{DynamicResource AppTextMuted}" />
                            <TextBlock Grid.Column="2" Text="Status" FontWeight="Bold" Foreground="{DynamicResource AppTextMuted}" />
                          </Grid>

                          <Separator Background="{DynamicResource AppBorder}" Height="1" Margin="0,0,0,5" />

                          <!-- Selectable rows for maintenance -->
                          <ListBox x:Name="BoilersListBoxWinter" Background="Transparent" BorderThickness="0" CornerRadius="4">
                            <!-- GB1 -->
                            <ListBoxItem Padding="10" Tag="GB1">
                              <Grid ColumnDefinitions="2*, 1*, 1*">
                                <TextBlock Grid.Column="0" Text="GB1" Foreground="{DynamicResource AppTextPrimary}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Gas" Foreground="{DynamicResource AppTextPrimary}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="Active" Foreground="#10B981" VerticalAlignment="Center"/>
                              </Grid>
                            </ListBoxItem>

                            <!-- GB2 -->
                            <ListBoxItem Padding="10" Tag="GB2">
                              <Grid ColumnDefinitions="2*, 1*, 1*">
                                <TextBlock Grid.Column="0" Text="GB2" Foreground="{DynamicResource AppTextPrimary}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Gas" Foreground="{DynamicResource AppTextPrimary}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="Active" Foreground="#10B981" VerticalAlignment="Center"/>
                              </Grid>
                            </ListBoxItem>

                            <!-- GB3 -->
                            <ListBoxItem Padding="10" Tag="GB3">
                              <Grid ColumnDefinitions="2*, 1*, 1*">
                                <TextBlock Grid.Column="0" Text="GB3" Foreground="{DynamicResource AppTextPrimary}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Gas" Foreground="{DynamicResource AppTextPrimary}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="Active" Foreground="#10B981" VerticalAlignment="Center"/>
                              </Grid>
                            </ListBoxItem>

                            <!-- OB1 -->
                            <ListBoxItem Padding="10" Tag="OB1">
                              <Grid ColumnDefinitions="2*, 1*, 1*">
                                <TextBlock Grid.Column="0" Text="OB1" Foreground="{DynamicResource AppTextPrimary}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Oil" Foreground="{DynamicResource AppTextPrimary}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="Active" Foreground="#10B981" VerticalAlignment="Center"/>
                              </Grid>
                            </ListBoxItem>
                          </ListBox>
                        </StackPanel>
                      </Border>

                      <!-- Maintenance Date choosing -->
                      <Grid ColumnDefinitions="Auto, Auto, *" Margin="0,20,0,0">
                        <!-- Maintenance start time -->
                        <StackPanel Grid.Column="0" Spacing="8" Margin="0,0,40,0">
                          <TextBlock Text="Maintenance Start" FontSize="14" Foreground="{DynamicResource AppTextPrimary}" FontWeight="SemiBold"/>
                          <StackPanel Orientation="Horizontal" Spacing="10">
                            <CalendarDatePicker x:Name="MaintenanceStartDatePickerWinter" Width="140" Watermark="Select date" />
                            <TimePicker x:Name="MaintenanceStartTimePickerWinter" />
                          </StackPanel>
                        </StackPanel>

                        <!-- Maintenance end time -->
                        <StackPanel Grid.Column="1" Spacing="8">
                          <TextBlock Text="Maintenance End" FontSize="14" Foreground="{DynamicResource AppTextPrimary}" FontWeight="SemiBold"/>
                          <StackPanel Orientation="Horizontal" Spacing="10">
                            <CalendarDatePicker x:Name="MaintenanceEndDatePickerWinter" Width="140" Watermark="Select date" />
                            <TimePicker x:Name="MaintenanceEndTimePickerWinter" />
                          </StackPanel>
                        </StackPanel>

                        <!-- Confirm Maintenance Button -->
                        <Button Grid.Column="2" HorizontalAlignment="Right"
                                Click="ConfirmMaintenanceWinter_Click"
                                Content="Confirm Maintenance"
                                FontWeight="SemiBold"
                                CornerRadius="4"
                                Padding="16,8"
                                VerticalAlignment="Bottom"
                                Margin="0,0,0,2">
                          <Button.Styles>
                            <!-- Default state -->
                            <Style Selector="Button">
                              <Setter Property="Background" Value="#3B82F6"/>
                              <Setter Property="Foreground" Value="White"/>
                            </Style>
                            <!-- Hover state, because default made the button not visible -->
                            <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                              <Setter Property="Background" Value="#2563EB"/>
                              <Setter Property="TextBlock.Foreground" Value="White"/>
                            </Style>
                          </Button.Styles>
                        </Button>
                      </Grid>

                    </StackPanel>

                  </Carousel.Items>
                </Carousel>
              </Grid>
            </Border>
          </StackPanel>


















          <!-- Scenario 2 View -->
          <StackPanel>
            <Border Padding="20">
              <TextBlock Text="Scenario 2" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimary}" HorizontalAlignment="Center" />
            </Border>
          </StackPanel>
        </Carousel.Items>
      </Carousel>


    </Grid>

  </ScrollViewer>
</UserControl>

