<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="using:Dv.App.Views.Optimization.Components"
             xmlns:vm="using:Dv.App.ViewModels"
             x:Class="Dv.App.Views.Optimization.Components.GraphsCard"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Avalonia;assembly=LiveChartsCore.SkiaSharpView.Avalonia"
             x:DataType="vm:OptimizationViewModel"
             x:CompileBindings="True">

    <StackPanel Spacing="16">
        <Border
            Margin="0,16,0,0"
            Background="{DynamicResource AppCardInner}"
            BorderBrush="{DynamicResource AppBorder}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="16">
            
            <StackPanel Spacing="12">
                <TextBlock 
                    Text="HeatDemand"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource AppTextPrimary}" />
                    
                <Grid Height="260">
                    <lvc:CartesianChart
                        x:Name="HeatDemandChart"
                        Background="{DynamicResource AppBackground}"
                        ZoomMode="None"
                        Margin="0">
                    </lvc:CartesianChart>
                </Grid>
            </StackPanel>
        </Border>

        <Border
            Margin="0,16,0,0"
            Background="{DynamicResource AppCardInner}"
            BorderBrush="{DynamicResource AppBorder}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="16">
            
            <StackPanel Spacing="12">
                <TextBlock 
                    Text="Electticity price"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource AppTextPrimary}" />
                    
                <Grid Height="260">
                    <lvc:CartesianChart
                        x:Name="ElectricityPriceChart"
                        Background="{DynamicResource AppBackground}"
                        ZoomMode="None"
                        Margin="0">
                    </lvc:CartesianChart>
                </Grid>
            </StackPanel>
        </Border>
        
        <Border
            Margin="0,16,0,0"
            Background="{DynamicResource AppCardInner}"
            BorderBrush="{DynamicResource AppBorder}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="16">
            
            <StackPanel Spacing="12">
                <TextBlock 
                    Text="Optimization results"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource AppTextPrimary}" />
                    
                <Grid Height="260">
                    <lvc:CartesianChart
                        x:Name="OptimizationResultsChart"
                        Background="{DynamicResource AppBackground}"
                        ZoomMode="None"
                        Margin="0">
                    </lvc:CartesianChart>
                </Grid>
            </StackPanel>
        </Border>

        <Border
            Margin="0,16,0,0"
            Background="{DynamicResource AppCardInner}"
            BorderBrush="{DynamicResource AppBorder}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="16">
            
            <StackPanel Spacing="12">
                <TextBlock 
                    Text="Electticity consumption"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource AppTextPrimary}" />
                    
                <Grid Height="260">
                    <lvc:CartesianChart
                        x:Name="ElectricityConsumptionChart"
                        Background="{DynamicResource AppBackground}"
                        ZoomMode="None"
                        Margin="0">
                    </lvc:CartesianChart>
                </Grid>
            </StackPanel>
        </Border>
        
        <Border
            Margin="0,16,0,0"
            Background="{DynamicResource AppCardInner}"
            BorderBrush="{DynamicResource AppBorder}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="16">
            
            <StackPanel Spacing="12">
                <TextBlock 
                    Text="Expenses"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource AppTextPrimary}" />
                    
                <Grid Height="260">
                    <lvc:CartesianChart
                        x:Name="ExpensesChart"
                        Background="{DynamicResource AppBackground}"
                        ZoomMode="None"
                        Margin="0">
                    </lvc:CartesianChart>
                </Grid>
            </StackPanel>
        </Border>
        
        <Border
            Margin="0,16,0,0"
            Background="{DynamicResource AppCardInner}"
            BorderBrush="{DynamicResource AppBorder}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="16">
            
            <StackPanel Spacing="12">
                <TextBlock 
                    Text="CO2 Emissions"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource AppTextPrimary}" />
                    
                <Grid Height="260">
                    <lvc:CartesianChart
                        x:Name="Co2EmissionsChart"
                        Background="{DynamicResource AppBackground}"
                        ZoomMode="None"
                        Margin="0">
                    </lvc:CartesianChart>
                </Grid>
            </StackPanel>
        </Border>

    </StackPanel>
</UserControl>
