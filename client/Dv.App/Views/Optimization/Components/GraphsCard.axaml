<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="using:Dv.App.Views.Optimization.Components"
             xmlns:vm="using:Dv.App.ViewModels"
             x:Class="Dv.App.Views.Optimization.Components.GraphsCard"
             x:DataType="vm:OptimizationViewModel"
             x:CompileBindings="True">

    <StackPanel Spacing="16">

        <components:ChartCardView DataContext="{Binding HeatDemandChart}" />

        <components:ChartCardView DataContext="{Binding ElectricityPriceChart}" />

        <components:ChartCardView DataContext="{Binding OptimizationResultsChart}" />

        <components:ChartCardView DataContext="{Binding ElectricityConsumptionChart}" />

        <components:ChartCardView DataContext="{Binding ExpensesChart}" />

        <components:ChartCardView DataContext="{Binding Co2EmissionsChart}" />

    </StackPanel>
</UserControl>
