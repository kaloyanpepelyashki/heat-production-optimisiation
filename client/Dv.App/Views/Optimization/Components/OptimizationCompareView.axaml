<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Dv.App.ViewModels"
             xmlns:components="using:Dv.App.Views.Optimization.Components"
             x:Class="Dv.App.Views.Optimization.Components.OptimizationCompareView"
             x:DataType="vm:OptimizationViewModel">

    <UserControl.Styles>
        <Style Selector="Button.layout-btn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextMuted}"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.layout-btn.active">
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.layout-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#E2E8F0"/>
        </Style>
        <Style Selector="Button.layout-btn.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#2563EB"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*" Margin="16">

        <!-- Header row -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock IsVisible="{Binding CompareVM.HasNoResults}"
                           Text="Run an optimization first to populate series"
                           FontSize="13"
                           Foreground="{DynamicResource AppTextMuted}"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Layout picker -->
            <Border Grid.Column="1"
                    Background="{DynamicResource AppCardInner}"
                    BorderBrush="{DynamicResource AppBorder}"
                    BorderThickness="1"
                    CornerRadius="7"
                    Padding="3">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button Classes="layout-btn"
                            Classes.active="{Binding CompareVM.IsSingleLayout}"
                            Command="{Binding CompareVM.SetSingleLayoutCommand}"
                            Content="▪"
                            FontSize="16"
                            Width="32" Height="26"
                            Padding="0"
                            ToolTip.Tip="Single chart"/>
                    <Button Classes="layout-btn"
                            Classes.active="{Binding CompareVM.IsTwoColumnLayout}"
                            Command="{Binding CompareVM.SetTwoColumnLayoutCommand}"
                            Content="▪ ▪"
                            FontSize="12"
                            Width="32" Height="26"
                            Padding="0"
                            ToolTip.Tip="Two columns"/>
                    <Button Classes="layout-btn"
                            Classes.active="{Binding CompareVM.IsFourGridLayout}"
                            Command="{Binding CompareVM.SetFourGridLayoutCommand}"
                            Content="⊞"
                            FontSize="16"
                            Width="32" Height="26"
                            Padding="0"
                            ToolTip.Tip="2×2 grid"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Single layout -->
        <Grid Grid.Row="1" IsVisible="{Binding CompareVM.IsSingleLayout}">
            <components:CompareChartSlot DataContext="{Binding CompareVM.Slot0}"/>
        </Grid>

        <!-- Two-column layout -->
        <Grid Grid.Row="1"
              ColumnDefinitions="*,*"
              ColumnSpacing="12"
              IsVisible="{Binding CompareVM.IsTwoColumnLayout}">
            <components:CompareChartSlot Grid.Column="0" DataContext="{Binding CompareVM.Slot0}"/>
            <components:CompareChartSlot Grid.Column="1" DataContext="{Binding CompareVM.Slot1}"/>
        </Grid>

        <!-- 2×2 grid layout -->
        <Grid Grid.Row="1"
              ColumnDefinitions="*,*"
              RowDefinitions="*,*"
              ColumnSpacing="12"
              RowSpacing="12"
              IsVisible="{Binding CompareVM.IsFourGridLayout}">
            <components:CompareChartSlot Grid.Row="0" Grid.Column="0" DataContext="{Binding CompareVM.Slot0}"/>
            <components:CompareChartSlot Grid.Row="0" Grid.Column="1" DataContext="{Binding CompareVM.Slot1}"/>
            <components:CompareChartSlot Grid.Row="1" Grid.Column="0" DataContext="{Binding CompareVM.Slot2}"/>
            <components:CompareChartSlot Grid.Row="1" Grid.Column="1" DataContext="{Binding CompareVM.Slot3}"/>
        </Grid>

    </Grid>

</UserControl>
