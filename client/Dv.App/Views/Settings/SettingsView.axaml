<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Dv.App.ViewModels"
             x:Class="Dv.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

  <UserControl.Styles>
    <Style Selector="RadioButton.theme-card">
      <Setter Property="Padding" Value="14,12" />
      <Setter Property="MinWidth" Value="110" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border x:Name="CardBorder"
                  Background="{DynamicResource AppCardInner}"
                  BorderBrush="{DynamicResource AppBorder}"
                  BorderThickness="2"
                  CornerRadius="10"
                  Padding="{TemplateBinding Padding}"
                  BoxShadow="0 1 4 0 #10000000">
            <ContentPresenter Content="{TemplateBinding Content}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>

    <Style Selector="RadioButton.theme-card:checked /template/ Border#CardBorder">
      <Setter Property="BorderBrush" Value="#db0b0b" />
      <Setter Property="Background" Value="{DynamicResource AppCard}" />
      <Setter Property="BoxShadow" Value="0 0 0 3 #25db0b0b" />
    </Style>

    <Style Selector="RadioButton.theme-card:pointerover /template/ Border#CardBorder">
      <Setter Property="BorderBrush" Value="#9CA3AF" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer>
    <StackPanel Spacing="20" Margin="10,10,10,24">

      <!-- Page header -->
      <TextBlock Text="Settings"
                 FontSize="28"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource AppTextPrimary}"
                 Margin="0,0,0,4" />

      <!-- ── Appearance ──────────────────────────────────────────── -->
      <Border Background="{DynamicResource AppCard}"
              CornerRadius="10"
              BoxShadow="0 4 12 0 #15000000"
              Padding="20">
        <StackPanel Spacing="16">

          <StackPanel Orientation="Horizontal" Spacing="12">
            <Border Background="#db0b0b" CornerRadius="6" Width="32" Height="32">
              <TextBlock Text="&#9728;" FontSize="16"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Foreground="White" />
            </Border>
            <TextBlock Text="Appearance"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource AppTextPrimary}"
                       VerticalAlignment="Center" />
          </StackPanel>

          <Rectangle Height="1" Fill="{DynamicResource AppBorder}" />

          <TextBlock Text="Theme"
                     FontSize="14"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource AppTextPrimary}" />

          <StackPanel Orientation="Horizontal" Spacing="12">

            <!-- Light -->
            <RadioButton GroupName="ThemeGroup"
                         Classes="theme-card"
                         IsChecked="{Binding IsLightTheme, Mode=TwoWay}">
              <StackPanel Spacing="10" HorizontalAlignment="Center">
                <Border Width="64" Height="44" CornerRadius="6" ClipToBounds="True"
                        BorderBrush="#E2E8F0" BorderThickness="1">
                  <Grid ColumnDefinitions="2*,3*" Background="White">
                    <Rectangle Grid.Column="0" Fill="#E8EDF2" />
                    <StackPanel Grid.Column="1" Spacing="5" Margin="5,8,5,0">
                      <Rectangle Height="4" Fill="#D1D5DB" RadiusX="2" RadiusY="2" />
                      <Rectangle Height="4" Fill="#D1D5DB" RadiusX="2" RadiusY="2" Width="18" HorizontalAlignment="Left" />
                      <Rectangle Height="4" Fill="#D1D5DB" RadiusX="2" RadiusY="2" />
                    </StackPanel>
                  </Grid>
                </Border>
                <TextBlock Text="Light"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AppTextPrimary}"
                           HorizontalAlignment="Center" />
              </StackPanel>
            </RadioButton>

            <!-- System -->
            <RadioButton GroupName="ThemeGroup"
                         Classes="theme-card"
                         IsChecked="{Binding IsSystemTheme, Mode=TwoWay}">
              <StackPanel Spacing="10" HorizontalAlignment="Center">
                <Border Width="64" Height="44" CornerRadius="6" ClipToBounds="True"
                        BorderBrush="#E2E8F0" BorderThickness="1">
                  <Grid ColumnDefinitions="*,*">
                    <Rectangle Grid.Column="0" Fill="#F1F5F9" />
                    <Rectangle Grid.Column="1" Fill="#2D3748" />
                  </Grid>
                </Border>
                <TextBlock Text="System"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AppTextPrimary}"
                           HorizontalAlignment="Center" />
              </StackPanel>
            </RadioButton>

            <!-- Dark -->
            <RadioButton GroupName="ThemeGroup"
                         Classes="theme-card"
                         IsChecked="{Binding IsDarkTheme, Mode=TwoWay}">
              <StackPanel Spacing="10" HorizontalAlignment="Center">
                <Border Width="64" Height="44" CornerRadius="6" ClipToBounds="True"
                        BorderBrush="#4A5568" BorderThickness="1">
                  <Grid ColumnDefinitions="2*,3*" Background="#1A202C">
                    <Rectangle Grid.Column="0" Fill="#2D3748" />
                    <StackPanel Grid.Column="1" Spacing="5" Margin="5,8,5,0">
                      <Rectangle Height="4" Fill="#4A5568" RadiusX="2" RadiusY="2" />
                      <Rectangle Height="4" Fill="#4A5568" RadiusX="2" RadiusY="2" Width="18" HorizontalAlignment="Left" />
                      <Rectangle Height="4" Fill="#4A5568" RadiusX="2" RadiusY="2" />
                    </StackPanel>
                  </Grid>
                </Border>
                <TextBlock Text="Dark"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AppTextPrimary}"
                           HorizontalAlignment="Center" />
              </StackPanel>
            </RadioButton>

          </StackPanel>

          <TextBlock Text="Customize how Heat Optimization looks. System follows your OS appearance settings."
                     FontSize="12"
                     Foreground="{DynamicResource AppTextMuted}"
                     TextWrapping="Wrap" />

        </StackPanel>
      </Border>

      <!-- ── Backend Services ────────────────────────────────────── -->
      <Border Background="{DynamicResource AppCard}"
              CornerRadius="10"
              BoxShadow="0 4 12 0 #15000000"
              Padding="20">
        <StackPanel Spacing="16">

          <StackPanel Orientation="Horizontal" Spacing="12">
            <Border Background="#8379e1" CornerRadius="6" Width="32" Height="32">
              <TextBlock Text="&#9654;" FontSize="12"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Foreground="White" />
            </Border>
            <TextBlock Text="Backend Services"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource AppTextPrimary}"
                       VerticalAlignment="Center" />
          </StackPanel>

          <Rectangle Height="1" Fill="{DynamicResource AppBorder}" />

          <!-- RDM -->
          <Border Background="{DynamicResource AppCardInner}" CornerRadius="8" Padding="14,11"
                  BorderBrush="{DynamicResource AppBorder}" BorderThickness="1">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Grid.Column="0" Spacing="3">
                <TextBlock Text="Render Data Manager" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource AppTextPrimary}" />
                <TextBlock Text="https://rdm-api.onrender.com/" FontSize="11"
                           Foreground="{DynamicResource AppTextMuted}" />
              </StackPanel>
              <!-- Checking -->
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                          VerticalAlignment="Center" Margin="12,0,0,0"
                          IsVisible="{Binding IsRdmChecking}">
                <Ellipse Width="8" Height="8" Fill="#94A3B8" />
                <TextBlock Text="Checking..." FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" />
              </StackPanel>
              <!-- Online -->
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                          VerticalAlignment="Center" Margin="12,0,0,0"
                          IsVisible="{Binding IsRdmOnline}">
                <Ellipse Width="8" Height="8" Fill="#22C55E" />
                <TextBlock Text="Connected" FontSize="11" Foreground="#22C55E" VerticalAlignment="Center" />
              </StackPanel>
              <!-- Offline -->
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                          VerticalAlignment="Center" Margin="12,0,0,0"
                          IsVisible="{Binding IsRdmOffline}">
                <Ellipse Width="8" Height="8" Fill="#EF4444" />
                <TextBlock Text="Offline" FontSize="11" Foreground="#EF4444" VerticalAlignment="Center" />
              </StackPanel>
            </Grid>
          </Border>

          <!-- SDM -->
          <Border Background="{DynamicResource AppCardInner}" CornerRadius="8" Padding="14,11"
                  BorderBrush="{DynamicResource AppBorder}" BorderThickness="1">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Grid.Column="0" Spacing="3">
                <TextBlock Text="Source Data Manager" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource AppTextPrimary}" />
                <TextBlock Text="https://sdm-api.onrender.com/" FontSize="11"
                           Foreground="{DynamicResource AppTextMuted}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                          VerticalAlignment="Center" Margin="12,0,0,0"
                          IsVisible="{Binding IsSdmChecking}">
                <Ellipse Width="8" Height="8" Fill="#94A3B8" />
                <TextBlock Text="Checking..." FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                          VerticalAlignment="Center" Margin="12,0,0,0"
                          IsVisible="{Binding IsSdmOnline}">
                <Ellipse Width="8" Height="8" Fill="#22C55E" />
                <TextBlock Text="Connected" FontSize="11" Foreground="#22C55E" VerticalAlignment="Center" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                          VerticalAlignment="Center" Margin="12,0,0,0"
                          IsVisible="{Binding IsSdmOffline}">
                <Ellipse Width="8" Height="8" Fill="#EF4444" />
                <TextBlock Text="Offline" FontSize="11" Foreground="#EF4444" VerticalAlignment="Center" />
              </StackPanel>
            </Grid>
          </Border>

          <!-- AM -->
          <Border Background="{DynamicResource AppCardInner}" CornerRadius="8" Padding="14,11"
                  BorderBrush="{DynamicResource AppBorder}" BorderThickness="1">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Grid.Column="0" Spacing="3">
                <TextBlock Text="Asset Manager" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource AppTextPrimary}" />
                <TextBlock Text="https://heat-production-optimisiation.onrender.com/" FontSize="11"
                           Foreground="{DynamicResource AppTextMuted}" TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                          VerticalAlignment="Center" Margin="12,0,0,0"
                          IsVisible="{Binding IsAmChecking}">
                <Ellipse Width="8" Height="8" Fill="#94A3B8" />
                <TextBlock Text="Checking..." FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                          VerticalAlignment="Center" Margin="12,0,0,0"
                          IsVisible="{Binding IsAmOnline}">
                <Ellipse Width="8" Height="8" Fill="#22C55E" />
                <TextBlock Text="Connected" FontSize="11" Foreground="#22C55E" VerticalAlignment="Center" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                          VerticalAlignment="Center" Margin="12,0,0,0"
                          IsVisible="{Binding IsAmOffline}">
                <Ellipse Width="8" Height="8" Fill="#EF4444" />
                <TextBlock Text="Offline" FontSize="11" Foreground="#EF4444" VerticalAlignment="Center" />
              </StackPanel>
            </Grid>
          </Border>

        </StackPanel>
      </Border>

      <!-- ── About ───────────────────────────────────────────────── -->
      <Border Background="{DynamicResource AppCard}"
              CornerRadius="10"
              BoxShadow="0 4 12 0 #15000000"
              Padding="20"
              Margin="0,0,0,20">
        <StackPanel Spacing="16">

          <StackPanel Orientation="Horizontal" Spacing="12">
            <Border Background="#ff9500" CornerRadius="6" Width="32" Height="32">
              <TextBlock Text="&#9829;" FontSize="14"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Foreground="White" />
            </Border>
            <TextBlock Text="About"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource AppTextPrimary}"
                       VerticalAlignment="Center" />
          </StackPanel>

          <Rectangle Height="1" Fill="{DynamicResource AppBorder}" />

          <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="10">

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Application"
                       FontSize="13" Foreground="{DynamicResource AppTextMuted}" VerticalAlignment="Center" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="Heat Optimization System"
                       FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimary}" VerticalAlignment="Center" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Version"
                       FontSize="13" Foreground="{DynamicResource AppTextMuted}" VerticalAlignment="Center" />
            <Border Grid.Row="1" Grid.Column="1" Background="#EFF6FF" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left">
              <TextBlock Text="1.0.0" FontSize="12" FontWeight="SemiBold" Foreground="#3B82F6" />
            </Border>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Platform"
                       FontSize="13" Foreground="{DynamicResource AppTextMuted}" VerticalAlignment="Center" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="Cross-platform Desktop"
                       FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimary}" VerticalAlignment="Center" />

          </Grid>

          <Rectangle Height="1" Fill="{DynamicResource AppBorder}" />

          <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
            <TextBlock Text="Made with" FontSize="13" Foreground="{DynamicResource AppTextMuted}" VerticalAlignment="Center" />
            <TextBlock Text="&#9829;" FontSize="14" Foreground="#db0b0b" VerticalAlignment="Center" />
            <TextBlock Text="by SPG3" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimary}" VerticalAlignment="Center" />
          </StackPanel>

        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
