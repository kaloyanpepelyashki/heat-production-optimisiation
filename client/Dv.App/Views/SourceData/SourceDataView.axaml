<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="using:Dv.App.ViewModels"
             xmlns:models="using:Dv.App.Models"
             x:Class="Dv.App.Views.SourceDataView"
             x:DataType="viewModels:SourceDataViewModel">
    
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <!-- to explain the syntax for setting width and height, RowDefinitions="Auto,Auto,*" so 3 rows
        and Auto means each row takes the height based on its content.
        ColumnDefinitions="*" so 1 column. -->
    <Grid 
        RowDefinitions="Auto,Auto,*"
        ColumnDefinitions="*">
        
        <!-- here we give an element the Row and Column it belongs to e.g. stack panel having Row 0 and Column 0 -->
        <StackPanel 
            Grid.Row="0" 
            Grid.Column="0" 
            Orientation="Vertical">
            
            <TextBlock 
                Classes="h1"
                Text="Source Data"/>
            
            <TextBlock 
                Classes="h2"
                Text="View source data for heat demand and electricity prices."/>
        </StackPanel>
        
        <StackPanel
            Grid.Row="1"
            Grid.Column="0"
            Orientation="Horizontal"
            Spacing="10"
            Margin="10,0,10,10">
            
            <TextBlock
                Text="From:"
                Foreground="Black"
                VerticalAlignment="Center"/>

            <DatePicker
                SelectedDate="{Binding FromDate}"
                FontSize="12"
                Padding="4"
                Height="35"
                Width="160"/>

            <TextBlock
                Text="To:"
                Foreground="Black"
                VerticalAlignment="Center"/>

            <DatePicker
                SelectedDate="{Binding ToDate}"
                FontSize="12"
                Padding="4"
                Height="35"
                Width="160"/>

            <Button
                Content="Load Data"
                Command="{Binding LoadCommand}"
                Height="35"
                Padding="16,0"
                Background="#007ACC"
                Foreground="White"/>

            <TextBlock
                IsVisible="{Binding IsLoading}"
                Text="Loading..."
                Foreground="#1363A4"
                VerticalAlignment="Center"/>

        </StackPanel>

        <StackPanel 
            Grid.Row="2" 
            Grid.Column="0"
            Orientation="Vertical"
            Margin="10,0,10,10"
            Spacing="8">

            <TextBlock
                IsVisible="{Binding HasError}"
                Text="{Binding ErrorMessage}"
                Foreground="#B00020"
                FontWeight="SemiBold"/>

            <ListBox ItemsSource="{Binding Data}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:SourceData">
                        <Border Padding="8" BorderThickness="0,0,0,1" BorderBrush="#DDDDDD">
                            <Grid ColumnDefinitions="2*,2*,1*,1*">
                                <TextBlock Grid.Column="0" Text="{Binding TimeFrom}" />
                                <TextBlock Grid.Column="1" Text="{Binding TimeTo}" />
                                <TextBlock Grid.Column="2" Text="{Binding HeatDemand}" />
                                <TextBlock Grid.Column="3" Text="{Binding ElectricityPrice}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
        
    </Grid>
    </ScrollViewer>
</UserControl>
